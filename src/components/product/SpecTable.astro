---
/**
 * Module 08 — grouped full technical specifications (per2.txt §十).
 */
export interface SpecGroup {
  title: string;
  rows: { label: string; value: string }[];
}

interface Props {
  title: string;
  groups: SpecGroup[];
}

const { title, groups } = Astro.props;
---

<section
  class="bg-gray-50/50 dark:bg-slate-900/50 border-b border-gray-100 dark:border-slate-800"
  data-ai-block="specs"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">{title}</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {
        groups.map((g) => (
          <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-3">
              {g.title}
            </h3>
            <dl class="space-y-2">
              {g.rows.map((r) => (
                <div class="flex items-baseline justify-between gap-4 text-sm">
                  <dt class="text-gray-500 dark:text-slate-400 shrink-0">{r.label}</dt>
                  <dd class="text-gray-900 dark:text-slate-200 font-medium text-right">{r.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>

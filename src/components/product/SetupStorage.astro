---
/**
 * Module 07 — setup, everyday use, and seasonal storage steps (per2.txt §九).
 */
export interface SetupStepItem {
  title: string;
  description: string;
}

interface Props {
  title: string;
  steps: SetupStepItem[];
  links: { label: string; href: string }[];
}

const { title, steps, links } = Astro.props;
---

<section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800" data-ai-block="setup">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">{title}</h2>
    <ol class="grid md:grid-cols-2 gap-4">
      {
        steps.map((step, i) => (
          <li class="flex items-start gap-4 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-100 dark:border-slate-700 p-5">
            <span class="shrink-0 w-8 h-8 rounded-full bg-sky-600 text-white text-sm font-bold flex items-center justify-center">
              {i + 1}
            </span>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100">{step.title}</h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-slate-400 leading-relaxed">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    {
      links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {links.map((l) => (
            <a
              href={l.href}
              class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
            >
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

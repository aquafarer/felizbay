---
/**
 * Module 02 — purchase confirmation bar under the product hero.
 * Four short blocks: included items / delivery / warranty / support.
 */
import Icon from '~/components/ui/Icon.astro';

export interface AssuranceItem {
  icon: string;
  title: string;
  text: string;
}

interface Props {
  items: AssuranceItem[];
}

const { items } = Astro.props;
---

<section
  class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800"
  data-ai-block="assurance"
  aria-label="Order information"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {
        items.map((it) => (
          <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700">
            <span class="shrink-0 w-9 h-9 rounded-lg bg-sky-50 dark:bg-sky-900/30 text-sky-600 dark:text-sky-400 flex items-center justify-center">
              <Icon name={it.icon} class="w-5 h-5" />
            </span>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-900 dark:text-slate-100">{it.title}</p>
              <p class="mt-1 text-xs text-gray-600 dark:text-slate-400 leading-relaxed">{it.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
/**
 * Module 03 + 05 — fit boundary table plus a factory-size checker with an
 * external-dimension diagram (per2.txt §五/§六, diagram per §二十 item 2).
 * The size selector is intentionally DECOUPLED from the cart: it only shows
 * the spec, the FOB wholesale price, and the dimension diagram for the
 * selected factory size, plus inquiry entry points. No SKU ever reaches
 * checkout.
 *
 * Size parsing, fill-volume estimation, and diagram geometry live in
 * ./diagram.ts — the single source shared by SSR (initial SVG) and the
 * client-side selector redraw, so the two can never drift apart.
 */
import type { PoolCatalogItem } from '~/data/pool-catalog';
import type { FitRow } from '~/data/product-page-content';
import { diagramInputForSize, estLitersFor, internalSizeFor, renderSizeDiagramSvg } from './diagram';

interface Props {
  ui: Record<string, string>;
  fitIntro: string;
  fitRows: FitRow[];
  fitNotice: { title: string; text: string };
  catalogItems: PoolCatalogItem[];
  quoteHref: string;
  compareHref: string;
  /** Retail product (Stripe SKU): the checker becomes fit-reference only —
   *  no FOB wholesale price is shown next to the retail buy path, and the
   *  retail-set notice clarifies the cart is not driven by this selector. */
  retailSku?: string;
  /** Link to the wholesale price list shown in the retail-set notice */
  wholesaleHref?: string;
  /** Factory photos keyed by catalog item number — when the selected size has
   *  a photo, the checker shows the real product photo of that exact size
   *  (QA #8: size switch syncs specs and imagery). Sizes without a photo keep
   *  the dimension diagram only. */
  itemPhotos?: Record<string, { src: string; alt: string; w: number; h: number }>;
}

const { ui, fitIntro, fitRows, fitNotice, catalogItems, quoteHref, compareHref, retailSku, wholesaleHref, itemPhotos } =
  Astro.props;

interface SizeOption {
  item: string;
  size: string;
  label: string;
  wall: string;
  fobUsd: number;
  estLiters: number | null;
  internal: string | null;
}

/** "15 cm" → 15; "10 / 15 cm" → 10 (first value, most conservative) */
const wallCmOf = (wall: string): number | undefined => {
  const first = parseFloat(wall);
  return Number.isNaN(first) ? undefined : first;
};

const sizeOptions: SizeOption[] = catalogItems
  .map((it) => {
    const wallCm = wallCmOf(it.wall);
    const estLiters = estLitersFor(it.size, wallCm);
    return {
      item: it.item,
      size: it.size,
      label: `${it.size} m`,
      wall: it.wall,
      fobUsd: it.fobUsd,
      estLiters,
      internal: internalSizeFor(it.size, wallCm),
    };
  })
  .filter((o) => o.estLiters !== null);

const first = sizeOptions[0];
const fmtLiters = (n: number) => `≈ ${n.toLocaleString('en-US')} L`;
const fmtFob = (n: number) => `$${n.toFixed(2)}`;

const diagramCaptions = { top: ui['product.diagTopView'], side: ui['product.diagSideView'] };
const firstDiagramInput = first ? diagramInputForSize(first.size, diagramCaptions) : null;
const firstDiagramSvg = firstDiagramInput ? renderSizeDiagramSvg(firstDiagramInput) : '';
---

<section class="bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-800" data-ai-block="fit">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100">
      {ui['product.fitTitle']}
    </h2>
    <p class="mt-3 max-w-3xl text-sm md:text-base text-gray-600 dark:text-slate-400 leading-relaxed">{fitIntro}</p>

    <div class="mt-8 grid lg:grid-cols-2 gap-6">
      {/* Fit boundary table */}
      <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-slate-800 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100 w-1/2">
                {ui['product.fitRecommended']}
              </th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100 w-1/2">{ui['product.fitCheck']}</th>
            </tr>
          </thead>
          <tbody>
            {
              fitRows.map((row) => (
                <tr class="border-t border-gray-100 dark:border-slate-700 align-top">
                  <td class="px-4 py-3 text-gray-700 dark:text-slate-300">
                    <span class="mr-1.5 text-green-600 dark:text-green-400">&#10003;</span>
                    {row.recommended}
                  </td>
                  <td class="px-4 py-3 text-gray-600 dark:text-slate-400">{row.check}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      {/* Size checker */}
      <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50 p-5 md:p-6">
        <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">{ui['product.fitCheckerTitle']}</h3>
        <label class="mt-4 block">
          <span class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">
            {ui['product.selectSize']}
          </span>
          <select
            id="fitg-size"
            class="mt-1.5 w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-gray-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
          >
            {
              sizeOptions.map((o) => (
                <option
                  value={o.item}
                  selected={o.item === first?.item}
                  data-size={o.label}
                  data-wall={o.wall}
                  data-fob={retailSku ? undefined : o.fobUsd.toFixed(2)}
                  data-liters={o.estLiters}
                  data-internal={o.internal ?? ''}
                >
                  {o.label} — {o.wall}
                </option>
              ))
            }
          </select>
        </label>

        {
          retailSku && (
            <div class="mt-3 rounded-lg border border-sky-200 dark:border-sky-900/50 bg-sky-50 dark:bg-sky-950/30 px-4 py-3">
              <p class="text-xs leading-relaxed text-sky-900 dark:text-sky-200">
                These are factory sizes for fit reference. The online purchase is the fixed retail set (SKU{' '}
                <span class="font-mono font-semibold">{retailSku}</span>) — selecting a size here does not change the
                cart. Wholesale FOB pricing for factory sizes is on the{' '}
                <a href={wholesaleHref || '/products/specs/'} class="font-semibold underline">
                  wholesale price list
                </a>
                .
              </p>
            </div>
          )
        }

        {/* External dimension diagram (per2.txt §二十 item 2) — redrawn by the selector script */}
        <div
          id="fitg-diagram"
          data-cap-top={diagramCaptions.top}
          data-cap-side={diagramCaptions.side}
          data-photos={JSON.stringify(itemPhotos ?? {})}
          class="mt-4 mx-auto max-w-md"
          set:html={firstDiagramSvg}
        />

        {/* Factory photo of the selected size (shown only when one exists) */}
        {
          itemPhotos && Object.keys(itemPhotos).length > 0 && (
            <div
              id="fitg-photo"
              class="mt-4 hidden overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
            >
              <img id="fitg-photo-img" alt="" class="w-full h-auto" loading="lazy" decoding="async" />
            </div>
          )
        }
        <p id="fitg-photo-cap" class="mt-1.5 hidden text-[11px] text-gray-400 dark:text-slate-500"></p>

        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3">
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-slate-400">
              {ui['product.externalSize']}
            </dt>
            <dd id="fitg-size-val" class="mt-0.5 text-sm font-semibold text-gray-900 dark:text-slate-100">
              {first?.label}
            </dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-slate-400">
              {ui['product.internalSize']}
            </dt>
            <dd id="fitg-internal-val" class="mt-0.5 text-sm font-semibold text-gray-900 dark:text-slate-100">
              {first?.internal || '—'}
            </dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-slate-400">
              {ui['product.wallLabel']}
            </dt>
            <dd id="fitg-wall-val" class="mt-0.5 text-sm font-semibold text-gray-900 dark:text-slate-100">
              {first?.wall}
            </dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-slate-400">
              {ui['product.estFillVolume']}
            </dt>
            <dd id="fitg-volume-val" class="mt-0.5 text-sm font-semibold text-gray-900 dark:text-slate-100">
              {first?.estLiters ? fmtLiters(first.estLiters) : '—'}
            </dd>
          </div>
          {
            !retailSku && (
              <div>
                <dt class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-slate-400">
                  {ui['product.fobWholesale']}
                </dt>
                <dd id="fitg-fob-val" class="mt-0.5 text-sm font-semibold text-sky-700 dark:text-sky-400">
                  {first ? fmtFob(first.fobUsd) : '—'}
                </dd>
              </div>
            )
          }
        </dl>

        <p class="mt-3 text-[11px] text-gray-400 dark:text-slate-500 leading-snug">{ui['product.estFillNote']}</p>

        <div class="mt-5 flex flex-wrap gap-3">
          <a
            id="fitg-quote"
            href={quoteHref}
            class="inline-flex items-center px-5 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-full hover:bg-sky-700 transition-colors"
          >
            {ui['product.requestWholesaleQuote']}
          </a>
          <a
            href={compareHref}
            class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-sm font-medium rounded-full hover:bg-white dark:hover:bg-slate-800 transition-colors"
          >
            {ui['product.compareAllSizes']}
          </a>
        </div>
      </div>
    </div>

    {/* Elevated / rental notice */}
    <div
      class="mt-6 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-5 py-4"
    >
      <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">{fitNotice.title}</h3>
      <p class="mt-1 text-sm text-amber-800/90 dark:text-amber-200/80 leading-relaxed">{fitNotice.text}</p>
    </div>
  </div>
</section>

<script>
  import { diagramInputForSize, renderSizeDiagramSvg } from './diagram';

  (() => {
    const sel = document.getElementById('fitg-size') as HTMLSelectElement | null;
    const sizeVal = document.getElementById('fitg-size-val');
    const internalVal = document.getElementById('fitg-internal-val');
    const wallVal = document.getElementById('fitg-wall-val');
    const volumeVal = document.getElementById('fitg-volume-val');
    // Absent on retail product pages (fit-reference mode, no FOB row rendered).
    const fobVal = document.getElementById('fitg-fob-val');
    const diagram = document.getElementById('fitg-diagram');
    const quoteLink = document.getElementById('fitg-quote');
    const photoWrap = document.getElementById('fitg-photo');
    const photoImg = document.getElementById('fitg-photo-img') as HTMLImageElement | null;
    const photoCap = document.getElementById('fitg-photo-cap');
    if (!sel || !sizeVal || !internalVal || !wallVal || !volumeVal) return;

    const fmtLiters = (n: number) => `≈ ${n.toLocaleString('en-US')} L`;

    const drawDiagram = (opt: HTMLOptionElement) => {
      if (!diagram) return;
      const raw = (opt.dataset.size ?? '').replace(/ m$/, '');
      const input = diagramInputForSize(raw, {
        top: diagram.dataset.capTop ?? '',
        side: diagram.dataset.capSide ?? '',
      });
      diagram.innerHTML = input ? renderSizeDiagramSvg(input) : '';
    };

    // Shareable link: keep the selected factory size in the URL so a copied
    // link reopens the same configuration (per2.txt §十七.4 / §十九).
    const syncUrl = (item: string) => {
      const url = new URL(window.location.href);
      url.searchParams.set('size', item);
      history.replaceState(null, '', url);
    };

    // The quote entry point must carry the selected model so support can
    // identify the exact configuration without asking (per2.txt §十九).
    const syncQuoteLink = (item: string) => {
      if (!(quoteLink instanceof HTMLAnchorElement)) return;
      const url = new URL(quoteLink.getAttribute('href') || '/', window.location.href);
      url.searchParams.set('size', item);
      quoteLink.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
    };

    // Factory photo registry for the selected size, parsed once (QA #8).
    let photos: Record<string, { src: string; alt: string; w: number; h: number }>;
    try {
      photos = JSON.parse(diagram?.dataset.photos ?? '{}');
    } catch {
      photos = {};
    }

    // Show the factory photo of the selected size when one is published.
    const showPhoto = (item: string) => {
      if (!photoWrap || !photoImg || !photoCap) return;
      const photo = photos[item];
      if (photo && photo.src) {
        if (photo.w && photo.h) {
          photoImg.setAttribute('width', String(photo.w));
          photoImg.setAttribute('height', String(photo.h));
        } else {
          photoImg.removeAttribute('width');
          photoImg.removeAttribute('height');
        }
        photoImg.src = photo.src;
        photoImg.alt = photo.alt || '';
        photoCap.textContent = photo.alt || '';
        photoWrap.classList.remove('hidden');
        photoCap.classList.remove('hidden');
      } else {
        photoWrap.classList.add('hidden');
        photoCap.classList.add('hidden');
      }
    };

    const update = () => {
      const opt = sel.options[sel.selectedIndex] as HTMLOptionElement | undefined;
      if (!opt) return;
      sizeVal.textContent = opt.dataset.size ?? '—';
      internalVal.textContent = opt.dataset.internal || '—';
      wallVal.textContent = opt.dataset.wall ?? '—';
      const liters = parseFloat(opt.dataset.liters ?? '');
      volumeVal.textContent = Number.isNaN(liters) ? '—' : fmtLiters(liters);
      if (fobVal) fobVal.textContent = opt.dataset.fob ? `$${opt.dataset.fob}` : '—';
      drawDiagram(opt);
      showPhoto(opt.value);
      syncUrl(opt.value);
      syncQuoteLink(opt.value);
    };

    // Restore a shared/refreshed selection from ?size=<item code>.
    const wanted = new URLSearchParams(window.location.search).get('size');
    if (wanted && Array.from(sel.options).some((o) => o.value === wanted)) {
      sel.value = wanted;
    }
    update();

    sel.addEventListener('change', update);
  })();
</script>

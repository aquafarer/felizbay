---
import Icon from '~/components/ui/Icon.astro';

export interface HeroHomeSlide {
  src: string;
  alt: string;
  title: string;
  kicker?: string;
  href: string;
}

interface HeroHomeAction {
  text?: string;
  href?: string;
  variant?: string;
  icon?: string;
}

interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  actions?: HeroHomeAction[];
  slides: HeroHomeSlide[];
  /** Localized CTA text under each slide caption */
  ctaLabel?: string;
  /** Static hero.image fallback when no slides are available */
  fallbackImage?: { src?: string; alt?: string };
  intervalMs?: number;
  label?: string;
}

const {
  tagline,
  title,
  subtitle,
  actions = [],
  slides,
  ctaLabel = 'Explore this setup',
  fallbackImage,
  intervalMs = 6000,
  label = 'Featured pool ideas',
} = Astro.props;

const hasSlides = slides.length > 0;
const hasControls = slides.length > 1;
---

<section
  id="hero-carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel-interval={intervalMs}
  class="relative flex min-h-svh items-center overflow-hidden bg-cyan-900 not-prose md:-mt-[76px] md:min-h-[calc(100svh+76px)]"
>
  <!-- Background: auto-rotating scenario photos (full-bleed, non-interactive) -->
  <div class="absolute inset-0" aria-hidden="true">
    {hasSlides ? (
      slides.map((slide, index) => (
        <div
          data-slide
          aria-hidden={index === 0 ? 'false' : 'true'}
          class:list={[
            'absolute inset-0 transition-opacity duration-700 ease-out',
            index === 0 ? 'opacity-100' : 'opacity-0',
          ]}
        >
          <img
            src={slide.src}
            alt={slide.alt}
            width="1600"
            height="900"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      ))
    ) : fallbackImage?.src ? (
      <img
        src={fallbackImage.src}
        alt={fallbackImage.alt || ''}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : null}
    <div class="absolute inset-0 bg-gradient-to-r from-cyan-900/85 via-cyan-900/40 to-transparent" />
    <div class="absolute inset-0 bg-gradient-to-t from-cyan-900/70 via-transparent to-transparent" />
  </div>

  <!-- Headline block (afarer-style left alignment on white) -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="max-w-3xl intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      {tagline && (
        <p class="mb-6 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.25em] text-white/60 sm:text-sm">
          <span class="h-px w-8 bg-primary" aria-hidden="true" />
          <span set:html={tagline} />
        </p>
      )}
      {title && (
        <h1
          class="text-4xl font-bold leading-[1.05] tracking-tight text-balance text-white sm:text-5xl md:text-6xl lg:text-7xl"
          set:html={title}
        />
      )}
      {subtitle && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-white/75 md:text-xl" set:html={subtitle} />
      )}
      {actions.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-4">
          {actions.map((action) =>
            action.variant === 'primary' ? (
              <a
                href={action.href}
                class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 font-semibold text-white shadow-xl transition-all hover:-translate-y-0.5 hover:bg-cyan-600"
              >
                {action.icon && <Icon name={action.icon} class="h-5 w-5" />}
                {action.text}
              </a>
            ) : (
              <a
                href={action.href}
                class="inline-flex items-center gap-2 rounded-full border border-white/25 px-8 py-4 font-medium text-white/85 backdrop-blur-sm transition-all hover:bg-white/10 hover:text-white"
              >
                {action.icon && <Icon name={action.icon} class="h-5 w-5" />}
                {action.text}
              </a>
            )
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Slide caption (bottom-left, crossfades with the background) -->
  {hasSlides && (
    <div class="absolute bottom-4 left-4 z-10 max-w-[55%] sm:bottom-6 sm:left-6 sm:max-w-[50%] md:max-w-xs lg:max-w-sm">
      {slides.map((slide, index) => (
        <a
          href={slide.href}
          data-slide-caption
          aria-hidden={index === 0 ? 'false' : 'true'}
          tabindex={index === 0 ? '0' : '-1'}
          class:list={[
            'group block transition-opacity duration-500',
            index === 0 ? 'opacity-100' : 'pointer-events-none absolute opacity-0',
          ]}
        >
          {slide.kicker && (
            <p class="text-xs font-semibold uppercase tracking-widest text-white/70 drop-shadow-sm">{slide.kicker}</p>
          )}
          <p class="text-lg font-bold leading-tight text-white drop-shadow-md sm:text-2xl">{slide.title}</p>
          <span class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-white/90 transition-colors group-hover:text-white">
            {ctaLabel}
            <Icon name="tabler:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  )}

  <!-- Carousel controls (bottom-right) -->
  {hasControls && (
    <div class="absolute bottom-4 right-4 z-20 flex items-center gap-2 sm:bottom-6 sm:right-6 sm:gap-3">
      <button
        type="button"
        data-carousel-prev
        aria-label="Previous slide"
        class="hidden h-10 w-10 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition hover:bg-black/60 sm:flex"
      >
        <Icon name="tabler:chevron-left" class="h-5 w-5" />
      </button>
      <div class="flex items-center gap-1.5">
        {slides.map((_, index) => (
          <button
            type="button"
            data-carousel-dot
            aria-label={`Go to slide ${index + 1}`}
            aria-current={index === 0 ? 'true' : 'false'}
            class:list={[
              'h-2 rounded-full transition-all sm:h-2.5',
              index === 0 ? 'w-4 bg-white sm:w-6' : 'w-2 bg-white/50 hover:bg-white/80 sm:w-2.5',
            ]}
          />
        ))}
      </div>
      <button
        type="button"
        data-carousel-next
        aria-label="Next slide"
        class="hidden h-10 w-10 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition hover:bg-black/60 sm:flex"
      >
        <Icon name="tabler:chevron-right" class="h-5 w-5" />
      </button>
    </div>
  )}

  <!-- Scroll cue (bottom-center, decorative) -->
  <div
    class="absolute bottom-0 left-1/2 z-10 hidden h-14 w-px -translate-x-1/2 bg-gradient-to-b from-white/40 to-transparent lg:block"
    aria-hidden="true"
  />
</section>

<script>
  (() => {
    const root = document.getElementById('hero-carousel');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const captions = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-slide-caption]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const prevButton = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (slides.length < 2) return;

    const intervalMs = Math.max(3000, Number(root.dataset.carouselInterval) || 6000);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | null = null;

    const render = (): void => {
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      captions.forEach((caption, index) => {
        const active = index === current;
        caption.classList.toggle('opacity-100', active);
        caption.classList.toggle('opacity-0', !active);
        caption.classList.toggle('pointer-events-none', !active);
        caption.classList.toggle('absolute', !active);
        caption.setAttribute('aria-hidden', active ? 'false' : 'true');
        caption.tabIndex = active ? 0 : -1;
      });
      dots.forEach((dot, index) => {
        const active = index === current;
        dot.setAttribute('aria-current', active ? 'true' : 'false');
        dot.classList.toggle('w-4', active);
        dot.classList.toggle('sm:w-6', active);
        dot.classList.toggle('bg-white', active);
        dot.classList.toggle('w-2', !active);
        dot.classList.toggle('sm:w-2.5', !active);
        dot.classList.toggle('bg-white/50', !active);
      });
    };

    const go = (index: number): void => {
      current = ((index % slides.length) + slides.length) % slides.length;
      render();
    };

    const stop = (): void => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = (): void => {
      stop();
      if (reducedMotion) return;
      timer = window.setInterval(() => {
        go(current + 1);
      }, intervalMs);
    };

    const advance = (index: number): void => {
      go(index);
      start();
    };

    prevButton?.addEventListener('click', () => advance(current - 1));
    nextButton?.addEventListener('click', () => advance(current + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => advance(index)));

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'ArrowLeft') {
        advance(current - 1);
      } else if (event.key === 'ArrowRight') {
        advance(current + 1);
      }
    });

    let touchStartX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event: TouchEvent) => {
        touchStartX = event.touches[0]?.clientX ?? null;
        stop();
      },
      { passive: true }
    );
    root.addEventListener(
      'touchend',
      (event: TouchEvent) => {
        if (touchStartX !== null) {
          const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStartX;
          if (Math.abs(delta) > 40) {
            advance(delta < 0 ? current + 1 : current - 1);
          } else {
            start();
          }
        }
        touchStartX = null;
      },
      { passive: true }
    );

    render();
    start();
  })();
</script>

---
import Icon from '~/components/ui/Icon.astro';

export interface HeroCarouselSlide {
  src: string;
  alt: string;
  title: string;
  kicker?: string;
  href: string;
}

interface Props {
  slides: HeroCarouselSlide[];
  intervalMs?: number;
  label?: string;
}

const { slides, intervalMs = 6000, label = 'Featured pool ideas' } = Astro.props;
const hasControls = slides.length > 1;
---

<section
  id="hero-carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel-interval={intervalMs}
  class="relative not-prose"
>
  <div
    class="relative m-auto w-full max-w-5xl overflow-hidden rounded-2xl shadow-xl aspect-[4/3] sm:aspect-[16/9] bg-slate-200 dark:bg-slate-800"
  >
    {
      slides.map((slide, index) => (
        <a
          href={slide.href}
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${slides.length}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
          tabindex={index === 0 ? '0' : '-1'}
          class:list={[
            'group absolute inset-0 block transition-opacity duration-700 ease-out',
            index === 0 ? 'z-10 opacity-100 pointer-events-auto' : 'z-0 opacity-0 pointer-events-none',
          ]}
        >
          <img
            src={slide.src}
            alt={slide.alt}
            width="1600"
            height="900"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" aria-hidden="true" />
          <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6 md:p-8 text-left max-w-[85%] sm:max-w-[70%]">
            {slide.kicker && (
              <p class="text-xs font-semibold uppercase tracking-widest text-white/80 drop-shadow-sm">{slide.kicker}</p>
            )}
            <p class="text-lg sm:text-2xl md:text-3xl font-bold leading-tight text-white drop-shadow-md">
              {slide.title}
            </p>
            <span class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-white/90 transition-colors group-hover:text-white">
              Explore this setup
              <Icon name="tabler:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </div>
        </a>
      ))
    }

    {
      hasControls && (
        <>
          <button
            type="button"
            data-carousel-prev
            aria-label="Previous slide"
            class="absolute left-3 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-slate-900 shadow-md transition hover:bg-white sm:flex"
          >
            <Icon name="tabler:chevron-left" class="h-5 w-5" />
          </button>
          <button
            type="button"
            data-carousel-next
            aria-label="Next slide"
            class="absolute right-3 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-slate-900 shadow-md transition hover:bg-white sm:flex"
          >
            <Icon name="tabler:chevron-right" class="h-5 w-5" />
          </button>
          <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-20 flex gap-1.5">
            {slides.map((_, index) => (
              <button
                type="button"
                data-carousel-dot
                aria-label={`Go to slide ${index + 1}`}
                aria-current={index === 0 ? 'true' : 'false'}
                class:list={[
                  'h-2 rounded-full transition-all',
                  index === 0 ? 'w-6 bg-white' : 'w-2 bg-white/50 hover:bg-white/80',
                ]}
              />
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('hero-carousel');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const prevButton = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (slides.length < 2) return;

    const intervalMs = Math.max(3000, Number(root.dataset.carouselInterval) || 6000);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | null = null;

    const render = (): void => {
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('z-10', active);
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('pointer-events-auto', active);
        slide.classList.toggle('z-0', !active);
        slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('pointer-events-none', !active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        slide.tabIndex = active ? 0 : -1;
      });
      dots.forEach((dot, index) => {
        const active = index === current;
        dot.setAttribute('aria-current', active ? 'true' : 'false');
        dot.classList.toggle('w-6', active);
        dot.classList.toggle('bg-white', active);
        dot.classList.toggle('w-2', !active);
        dot.classList.toggle('bg-white/50', !active);
      });
    };

    const go = (index: number): void => {
      current = ((index % slides.length) + slides.length) % slides.length;
      render();
    };

    const stop = (): void => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = (): void => {
      stop();
      if (reducedMotion) return;
      timer = window.setInterval(() => {
        go(current + 1);
      }, intervalMs);
    };

    const advance = (index: number): void => {
      go(index);
      start();
    };

    prevButton?.addEventListener('click', () => advance(current - 1));
    nextButton?.addEventListener('click', () => advance(current + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => advance(index)));

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'ArrowLeft') {
        advance(current - 1);
      } else if (event.key === 'ArrowRight') {
        advance(current + 1);
      }
    });

    let touchStartX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event: TouchEvent) => {
        touchStartX = event.touches[0]?.clientX ?? null;
        stop();
      },
      { passive: true }
    );
    root.addEventListener(
      'touchend',
      (event: TouchEvent) => {
        if (touchStartX !== null) {
          const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStartX;
          if (Math.abs(delta) > 40) {
            advance(delta < 0 ? current + 1 : current - 1);
          } else {
            start();
          }
        }
        touchStartX = null;
      },
      { passive: true }
    );

    render();
    start();
  })();
</script>

---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import HeroCarousel from '~/components/widgets/HeroCarousel.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getProducts } from '~/utils/products';
import { POOL_IDEAS, findPoolIdea, type PoolIdea } from '~/data/pool-ideas';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/home.ts';
import { getUiForLang } from '~/i18n/generated/ui-all';

const lang = 'en';
const t = (key: string) => getUiForLang(lang)?.[key] || '';

setPageContentData(__pageData);
const page = getPageContent(lang, 'home');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const compareCollections = page.compare_collections ?? {};
const customerTypes = page.content_customer_types ?? {};
const features = page.features ?? {};
const categories = page.content_categories ?? {};
const steps = page.steps ?? {};
const compliance = page.content_compliance ?? {};
const faqs = page.faqs ?? {};
const cta = page.cta ?? {};

// Homepage is consumer-facing: only retail (single-piece purchase) products appear here.
const poolProducts = (await getProducts()).filter((p) => p.sku).slice(0, 3);

// Consumer scenario showcase — photos and copy from the pool-ideas scenario pages.
const scenarioSlugs = [
  'large-pools-for-family-gatherings',
  'pools-for-water-fitness-and-recreation',
  'pools-for-pet-families',
  'cold-plunge-and-recovery-pools',
  'pools-for-dink-households',
  'townhome-and-compact-yard-pools',
  'pools-for-retirees-and-empty-nesters',
];
const scenarioCards = scenarioSlugs
  .map((slug) => findPoolIdea(slug))
  .filter((idea): idea is PoolIdea & { image: string } => Boolean(idea && idea.image));

// Hero visual: auto-rotating carousel of the 7 consumer scenario photos, each linking to its pool-ideas page.
const heroSlides = scenarioCards.map((idea) => ({
  src: idea.image,
  alt: idea.imageAlt ?? idea.title,
  title: idea.navTitle,
  kicker: 'Pool Idea',
  href: `/pool-ideas/${idea.slug}`,
}));

const metadata = {
  title: `Premium Drop Stitch Inflatable Pools | ${SITE.name}`,
  description:
    'Felizbay premium drop stitch inflatable pools — rigid walls, fast setup, and easy storage for backyards and outdoor spaces. Compare sizes and find your pool.',
};
---

<Layout metadata={metadata}>
  {
    hero.image || hero.title ? (
      <Hero
        tagline={hero.tagline}
        title={hero.title}
        subtitle={hero.subtitle}
        actions={hero.actions}
        image={heroSlides.length === 0 ? hero.image : undefined}
      >
        {heroSlides.length > 0 && <HeroCarousel slot="visual" slides={heroSlides} />}
      </Hero>
    ) : null
  }

  <Stats title={stats.title} stats={stats.stats} />

  <Features2
    id={features.id}
    tagline={features.tagline}
    title={features.title}
    subtitle={features.subtitle}
    columns={3}
    items={features.items}
  />

  {
    compareCollections.rows ? (
      <section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
        <div class="text-center mb-8">
          {compareCollections.tagline && (
            <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
              {compareCollections.tagline}
            </p>
          )}
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading" set:html={compareCollections.title} />
          <p class="mt-3 text-xl text-muted dark:text-slate-400 font-medium max-w-2xl mx-auto">
            {compareCollections.subtitle}
          </p>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-700">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 dark:bg-slate-800/60 text-left">
                <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">
                  {compareCollections.headers?.collection}
                </th>
                <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">
                  {compareCollections.headers?.sizes}
                </th>
                <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">
                  {compareCollections.headers?.best_for}
                </th>
              </tr>
            </thead>
            <tbody>
              {compareCollections.rows.map(
                (row: { collection: string; sizes: string; best_for: string; href: string }) => (
                  <tr class="border-t border-gray-100 dark:border-slate-700">
                    <td class="px-4 py-3">
                      <a class="font-medium text-primary hover:underline" href={row.href}>
                        {row.collection}
                      </a>
                    </td>
                    <td class="px-4 py-3 text-gray-600 dark:text-slate-300 whitespace-nowrap">{row.sizes}</td>
                    <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.best_for}</td>
                  </tr>
                )
              )}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-center text-sm text-muted dark:text-slate-400">{compareCollections.note}</p>
      </section>
    ) : null
  }

  <!-- Scenario showcase (consumer pool ideas with photos) -->
  <section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
        {customerTypes.tagline || 'Pool Ideas'}
      </p>
      <h2
        class="text-3xl md:text-4xl font-bold tracking-tight font-heading"
        set:html={customerTypes.title || 'The Right Pool for Your Space'}
      />
      <p class="mt-3 text-xl text-muted dark:text-slate-400 font-medium max-w-2xl mx-auto">
        {customerTypes.subtitle || ''}
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        scenarioCards.map((idea) => (
          <a
            href={`/pool-ideas/${idea.slug}`}
            class="group block rounded-2xl overflow-hidden border border-gray-100 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-lg transition-shadow"
          >
            <div class="overflow-hidden">
              <img
                src={idea.image}
                alt={idea.imageAlt ?? idea.title}
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
                class="aspect-[4/3] w-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-4">
              <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">{idea.navTitle}</h3>
              <p class="mt-1 text-sm text-gray-500 dark:text-slate-400 line-clamp-2">{idea.intro[0]}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary dark:text-blue-400">
                Explore this setup
                <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
              </span>
            </div>
          </a>
        ))
      }
      <a
        href="/pool-ideas"
        class="group flex flex-col items-center justify-center text-center p-6 rounded-2xl bg-gray-900 dark:bg-slate-800 text-white hover:bg-gray-800 dark:hover:bg-slate-700 transition-colors"
      >
        <Icon name="tabler:pool" class="w-8 h-8 mb-3" />
        <span class="text-base font-semibold">All Pool Ideas</span>
        <span class="mt-1 text-sm text-gray-300 dark:text-slate-300">Browse every backyard scenario</span>
        <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-gray-200 dark:text-slate-200">
          View all {POOL_IDEAS.length}
          <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
        </span>
      </a>
    </div>
  </section>

  <!-- Product highlights -->
  {
    poolProducts.length > 0 && (
      <section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
        <div class="text-center mb-8">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">
            {categories.tagline || t('product.catalog') || 'Shop Pools'}
          </p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">
            {categories.title || 'Explore Our Pools'}
          </h2>
          <p class="mt-3 text-xl text-muted dark:text-slate-400 font-medium max-w-2xl mx-auto">
            {categories.subtitle || ''}
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {poolProducts.map((p) => (
            <ProductCard product={p} lang={lang} />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a
            href="/products"
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 dark:border-slate-600 text-gray-700 dark:text-slate-300 font-medium rounded-full hover:border-gray-300 dark:hover:border-slate-500 hover:bg-gray-50 dark:hover:bg-slate-800 transition-all text-sm"
          >
            <Icon name="tabler:pool" class="w-4 h-4" />
            View All Pools
          </a>
        </div>
      </section>
    )
  }

  <Steps2 title={steps.title} items={steps.items} image={steps.image} />

  <Features2
    tagline={compliance.tagline}
    title={compliance.title}
    subtitle={compliance.subtitle}
    columns={4}
    items={compliance.items}
  />

  <FAQs title={faqs.title} subtitle={faqs.subtitle} columns={faqs.columns} items={faqs.items} />

  {cta.title ? <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions ?? []} /> : null}
</Layout>

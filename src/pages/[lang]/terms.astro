const metadata = {
  title: meta.title,
  description: meta.description,
  ignoreTitleTemplate: true,
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: 'Terms and Conditions' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {Body ? (
    <Body lang={lang} />
  ) : (
    <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
      <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter">Terms and Conditions</h1>
      <div class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8">
        <p>
          <em>Last updated: October 19, 2026</em>
        </p>
        <p>Please read these terms and conditions carefully before using Our Service.</p>

        <h2 id="warranty">Warranty</h2>
        <p>
          Felizbay pools and SPA tubs carry a 2-year limited warranty against manufacturing defects, covering seams,
          valves, and fabric. Every pool ships with a repair kit for small field repairs, and spare parts — valves,
          patches, pumps, covers — remain available through info@felizbay.com for the life of the product.
          Model-specific warranty documentation is provided with each product; where that documentation differs from
          this section, it governs. To make a warranty claim or request spare parts, contact info@felizbay.com.
        </p>

        <h2 id="orders-and-deliveries">Orders & Deliveries</h2>
        <p>
          Orders are placed through written quotations and order confirmations. Your quotation specifies prices,
          delivery terms, lead times, and any order-specific conditions, including any return arrangements. To request a
          quotation, use the request form on this site or contact info@felizbay.com.
        </p>


---
import AdminLayout from '~/layouts/AdminLayout.astro';
export const prerender = true;
---

<AdminLayout title="Advisor Stats" active="advisor-stats">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-xl font-bold">Pool Advisor Stats (GEO KPI)</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        Anonymous selection events from /find-your-pool — coarse answer buckets only, no PII, purged after 180 days.
      </p>
    </div>
    <div class="flex flex-wrap gap-2" id="day-tabs">
      <button class="day-tab px-3 py-1.5 text-sm rounded-full border" data-days="7">
        7 days
      </button>
      <button class="day-tab px-3 py-1.5 text-sm rounded-full border" data-days="30">
        30 days
      </button>
      <button class="day-tab px-3 py-1.5 text-sm rounded-full border" data-days="90">
        90 days
      </button>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8" id="kpi-cards">
    <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-5">
      <div class="text-2xl font-bold" id="kpi-filters">
        —
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Unique filter sessions</p>
    </div>
    <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-5">
      <div class="text-2xl font-bold" id="kpi-clicks">
        —
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Result-card clicks</p>
    </div>
    <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-5">
      <div class="text-2xl font-bold" id="kpi-ctr">
        —
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Click rate (clicks ÷ sessions)</p>
    </div>
    <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-5">
      <div class="text-2xl font-bold" id="kpi-nomatch">
        —
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">No-match sessions (rate)</p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
        Top clicked products
      </h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-800">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800 text-sm">
          <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Product / Guide</th>
              <th class="px-4 py-3 text-right font-medium">Clicks</th>
            </tr>
          </thead>
          <tbody id="product-rows" class="divide-y divide-gray-200 dark:divide-gray-800">
            <tr>
              <td colspan="2" class="px-4 py-8 text-center text-gray-400">
                Loading…
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
        Top no-match answers
      </h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-800">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800 text-sm">
          <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Answer set</th>
              <th class="px-4 py-3 text-right font-medium">Count</th>
            </tr>
          </thead>
          <tbody id="nomatch-rows" class="divide-y divide-gray-200 dark:divide-gray-800">
            <tr>
              <td colspan="2" class="px-4 py-8 text-center text-gray-400">
                Loading…
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var days = 30;

      var ANSWER_LABELS = {
        use: 'Use',
        space: 'Space',
        who: 'Who',
        install: 'Install',
        climate: 'Climate',
        purpose: 'Purpose',
        dims: 'Area (m)',
        target: 'Target',
      };

      function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function prettyAnswers(raw) {
        var a;
        try {
          a = typeof raw === 'string' ? JSON.parse(raw) : raw;
        } catch (e) {
          return escapeHtml(raw);
        }
        if (!a || typeof a !== 'object') return '—';
        return (
          Object.keys(a)
            .map(function (k) {
              return (ANSWER_LABELS[k] || k) + ': ' + a[k];
            })
            .join(' · ') || '—'
        );
      }

      function setTabs() {
        document.querySelectorAll('.day-tab').forEach(function (btn) {
          var on = Number(btn.dataset.days) === days;
          btn.classList.toggle('bg-blue-600', on);
          btn.classList.toggle('text-white', on);
          btn.classList.toggle('border-blue-600', on);
        });
      }

      function setCell(id, text) {
        document.getElementById(id).textContent = text;
      }

      async function load() {
        setTabs();
        try {
          var res = await fetch('/api/admin/advisor-stats?days=' + days, { credentials: 'same-origin' });
          if (res.status === 401) {
            window.location.replace('/login');
            return;
          }
          if (!res.ok) throw new Error(await res.text());
          var data = await res.json();
          var byType = {};
          (data.byType || []).forEach(function (r) {
            byType[r.t] = r.c;
          });
          var sessions = byType['quiz_filter'] || 0;
          var clicks = byType['result_click'] || 0;
          var noMatch = byType['no_match'] || 0;
          setCell('kpi-filters', sessions);
          setCell('kpi-clicks', clicks);
          setCell('kpi-ctr', sessions > 0 ? (Math.round((clicks / sessions) * 1000) / 10).toFixed(1) + '%' : '—');
          var denom = sessions + noMatch;
          setCell(
            'kpi-nomatch',
            noMatch + (denom > 0 ? ' (' + (Math.round((noMatch / denom) * 1000) / 10).toFixed(1) + '%)' : '')
          );

          var productRows = data.topProducts || [];
          document.getElementById('product-rows').innerHTML = productRows.length
            ? productRows
                .map(function (r) {
                  return (
                    '<tr><td class="px-4 py-3">' +
                    escapeHtml(r.slug) +
                    '</td><td class="px-4 py-3 text-right font-medium">' +
                    r.c +
                    '</td></tr>'
                  );
                })
                .join('')
            : '<tr><td colspan="2" class="px-4 py-8 text-center text-gray-400">No clicks recorded yet.</td></tr>';

          var noMatchRows = data.topNoMatch || [];
          document.getElementById('nomatch-rows').innerHTML = noMatchRows.length
            ? noMatchRows
                .map(function (r) {
                  return (
                    '<tr><td class="px-4 py-3">' +
                    prettyAnswers(r.answers) +
                    '</td><td class="px-4 py-3 text-right font-medium">' +
                    r.c +
                    '</td></tr>'
                  );
                })
                .join('')
            : '<tr><td colspan="2" class="px-4 py-8 text-center text-gray-400">No no-match sessions — good.</td></tr>';
        } catch (err) {
          document.getElementById('product-rows').innerHTML =
            '<tr><td colspan="2" class="px-4 py-8 text-center text-red-500">Failed to load: ' +
            escapeHtml(String(err)) +
            '</td></tr>';
        }
      }

      document.querySelectorAll('.day-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          days = Number(btn.dataset.days) || 30;
          load();
        });
      });

      load();
    })();
  </script>
</AdminLayout>

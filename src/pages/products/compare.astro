---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import { SITE } from 'astrowind:config';
import { getProducts } from '~/utils/products';
import { poolSeries, PRICE_BASIS_NOTE } from '~/data/pool-catalog';

const metadata = {
  title: `Compare Drop Stitch Inflatable Pools | ${SITE.name}`,
  description:
    'Compare Felizbay retail drop stitch inflatable pools side by side — shape, wall material, pressure, setup time, and single-piece retail price. Wholesale and project pools are listed separately.',
};

const products = await getProducts();
// Channel split: the comparison table carries same-caliber retail prices only;
// wholesale-only products (no checkout SKU) get a separate business section and
// are never price-compared against retail prices (audit 2026-10-27 §二/§四.5).
const retailProducts = products.filter((p) => p.sku);
const wholesaleProducts = products.filter((p) => !p.sku);

const specGetter = (label: string) => {
  return (p: (typeof products)[number]) => {
    const s = p.specs?.find((s) => s.label.toLowerCase().includes(label));
    return s?.value || '-';
  };
};

const comparisonRows = [
  { label: 'Category', key: 'categoryLabel' as const, transform: (v: string) => v },
  { label: 'Shape', key: 'shape' as const, getter: specGetter('shape') },
  { label: 'Color', key: 'color' as const, getter: specGetter('color') },
  { label: 'Dimensions', key: 'dimensions' as const, getter: specGetter('size range') },
  { label: 'Wall Material', key: 'material' as const, getter: specGetter('material') },
  { label: 'Recommended Pressure', key: 'pressure' as const, getter: specGetter('pressure') },
  { label: 'Wall Thickness', key: 'thickness' as const, getter: specGetter('thickness') },
  { label: 'Setup Time', key: 'setup' as const, getter: specGetter('inflation') },
  {
    label: 'Water Capacity (approx.)',
    key: 'capacity' as const,
    getter: (p: (typeof products)[number]) =>
      (
        ({
          'hot-tub-round': '≈2,500 L at full fill (Ø 2 × 0.8 m; seats displace some volume)',
        }) as Record<string, string>
      )[p.slug] ?? '—',
  },
  {
    label: 'Heater (optional)',
    key: 'heater' as const,
    getter: (p: (typeof products)[number]) =>
      p.slug === 'hot-tub-round'
        ? 'External heater sold separately — compatibility confirmed per order'
        : 'Not applicable (swim pool)',
  },
  { label: 'Included', key: 'included' as const, getter: specGetter('included') },
  {
    label: 'Retail Price',
    key: 'price' as const,
    getter: (p: (typeof products)[number]) => {
      if (!p.price?.amount) return '-';
      return p.price.currency === 'USD' || !p.price.currency
        ? `$${p.price.amount} retail`
        : `${p.price.currency} ${p.price.amount} retail`;
    },
  },
];

/** Approximate geometric full-fill volume in liters, computed from catalog sizes */
function estimateVolumeLiters(size: string): number | null {
  const nums = size
    .replace('Ø', '')
    .split('×')
    .map((p) => parseFloat(p.trim()))
    .filter((n) => !Number.isNaN(n));
  if (size.includes('Ø') && nums.length >= 2) {
    return Math.round(Math.PI * Math.pow(nums[0] / 2, 2) * nums[1] * 1000);
  }
  if (nums.length >= 3) {
    return Math.round(nums[0] * nums[1] * nums[2] * 1000);
  }
  return null;
}
---

<Layout metadata={metadata}>
  <section class="max-w-6xl mx-auto py-24 px-6">
    <a href="/products/" class="text-sm text-sky-600 hover:text-sky-700">
      &larr; Products
    </a>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">Compare Drop Stitch Inflatable Pools</h1>
    <p class="mt-4 text-lg text-gray-500">
      Compare Felizbay drop stitch pools side by side to find the right inflatable swimming pool for your backyard. All
      prices in this table are single-piece online retail prices — every model listed here can be purchased directly.
    </p>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th class="sticky left-0 bg-white z-10 px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[140px]">
              Specification
            </th>
            {retailProducts.map((p) => (
              <th class="px-4 py-3 text-center font-semibold text-gray-900 border-b-2 border-gray-200 min-w-[120px]">
                <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{p.categoryLabel}</div>
                <a href={`/products/${p.slug}/`} class="hover:text-sky-600">
                  {p.title}
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row, i) => (
            <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
              <td
                class="sticky left-0 px-4 py-3 font-medium text-gray-700 border-b border-gray-200"
                style={i % 2 === 0 ? 'background:#f9fafb' : 'background:white'}
              >
                {row.label}
              </td>
              {retailProducts.map((p) => {
                const value = row.getter ? row.getter(p) : (p as any)[row.key];
                return <td class="px-4 py-3 text-center text-gray-600 border-b border-gray-200">{value || '-'}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-gray-400 max-w-3xl">
      “—” = not published yet: the blue and grey sets are fixed single-size SKUs whose exact external dimensions, wall
      thickness and capacity are pending publication — request them before ordering. Water capacity is the approximate
      geometric volume at full fill; actual fill follows the marked fill line. Retail prices are single-piece online
      prices; FOB wholesale pricing is listed separately below.
    </p>

    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {retailProducts.map((p) => (
        <a
          href={`/products/${p.slug}/`}
          class="block p-4 bg-white border border-gray-200 rounded-xl hover:shadow-md transition-shadow text-center"
        >
          <div class="text-xs uppercase tracking-wider text-sky-600 font-medium">{p.categoryLabel}</div>
          <div class="mt-1 font-semibold text-gray-900">{p.title}</div>

          <div class="mt-2 text-xs text-sky-600 hover:underline">View details →</div>
        </a>
      ))}
    </div>

    {wholesaleProducts.length > 0 && (
      <section class="mt-16 pt-12 border-t border-gray-200" id="wholesale" data-channel="wholesale">
        <h2 class="text-2xl md:text-3xl font-semibold text-gray-900">Wholesale & Project Pools</h2>
        <p class="mt-3 text-base text-gray-500 max-w-3xl leading-relaxed">
          The collections below are produced for business buyers — soaking tubs and swimming pools for vacation rentals,
          glamping sites, and hospitality projects. Prices are wholesale FOB (FOB Qingdao, price basis 20 pcs per item);
          these models are not available as single-piece retail purchases, so they are listed separately instead of
          being compared against retail prices above.
        </p>
        <div class="mt-8 grid md:grid-cols-2 gap-4">
          {wholesaleProducts.map((p) => (
            <ProductCard product={p} showMeta={false} />
          ))}
        </div>
        <a
          href="/products/specs/"
          class="mt-6 inline-flex items-center gap-2 px-6 py-3 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors"
        >
          Factory sizes &amp; wholesale price list →
        </a>

        <!-- Interactive size comparison: filter factory sizes by series (client-side) -->
        <h3 class="mt-12 text-xl md:text-2xl font-semibold text-gray-900">Compare Factory Sizes Interactively</h3>
        <p class="mt-2 text-sm text-gray-500 max-w-3xl leading-relaxed">
          Every catalog size in one filterable table — pick a series to compare sizes, wall thickness, estimated
          full-fill volume, packed weights, and wholesale FOB unit prices side by side.
          {PRICE_BASIS_NOTE.split(' — ')[0]}, MOQ 20 pcs per item. Volume is the approximate geometric capacity at full
          fill — actual fill follows the marked fill line, and “—” marks figures pending publication.
        </p>
        <div class="mt-5 flex flex-wrap gap-2" data-size-filter>
          <button
            type="button"
            data-series="all"
            aria-pressed="false"
            class="px-4 py-2 text-sm font-medium rounded-full border transition-colors"
          >
            All series
          </button>
          {poolSeries.map((s) => (
            <button
              type="button"
              data-series={s.id}
              aria-pressed="false"
              class="px-4 py-2 text-sm font-medium rounded-full border transition-colors"
            >
              {s.name}
            </button>
          ))}
        </div>
        <p class="mt-3 text-xs text-gray-400" data-size-count></p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm border-collapse" data-size-table>
            <thead>
              <tr>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">Item no.</th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">Series</th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">Size (m)</th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">Wall</th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">
                  Est. volume (L)
                </th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">
                  Packed weight
                </th>
                <th class="px-4 py-3 text-left font-semibold text-gray-900 border-b-2 border-gray-200">FOB USD/unit</th>
              </tr>
            </thead>
            <tbody>
              {poolSeries.flatMap((s) =>
                s.items.map((it) => (
                  <tr data-series={s.id} class="border-b border-gray-100">
                    <td class="px-4 py-2.5 font-medium text-gray-800">{it.item}</td>
                    <td class="px-4 py-2.5 text-gray-600">{s.name}</td>
                    <td class="px-4 py-2.5 text-gray-600">{it.size}</td>
                    <td class="px-4 py-2.5 text-gray-600">{it.wall}</td>
                    <td class="px-4 py-2.5 text-gray-600">
                      {estimateVolumeLiters(it.size)?.toLocaleString('en-US') ?? '—'}
                    </td>
                    <td class="px-4 py-2.5 text-gray-600">{it.weightKg != null ? `${it.weightKg} kg` : '—'}</td>
                    <td class="px-4 py-2.5 text-gray-800">${it.fobUsd}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="sr-only" data-ai-block="definition" aria-hidden="true">
      <p>
        Felizbay retail product comparison table covering {retailProducts.length} single-piece retail pools across
        {['pool'].filter((c) => retailProducts.some((p) => p.category === c)).length}
        categories. Compare shape, color, wall material, pressure, and retail price.
        {wholesaleProducts.length > 0 &&
          ` ${wholesaleProducts.length} wholesale-only collections (FOB Qingdao, price basis 20 pcs per item) are listed in a separate business section and are not price-compared against retail products.`}
      </p>
    </section>
  </section>

  <script>
    (function () {
      const filter = document.querySelector('[data-size-filter]');
      const table = document.querySelector('[data-size-table]');
      if (!filter || !table) return;
      const buttons = Array.from(filter.querySelectorAll('button[data-series]')) as HTMLButtonElement[];
      const rows = Array.from(table.querySelectorAll('tbody tr[data-series]')) as HTMLTableRowElement[];
      const countEl = document.querySelector('[data-size-count]') as HTMLElement | null;
      const ACTIVE = ['bg-sky-600', 'border-sky-600', 'text-white'];
      const IDLE = ['border-gray-300', 'text-gray-700', 'hover:bg-gray-50'];

      function apply(series: string): void {
        let visible = 0;
        rows.forEach((row) => {
          const show = series === 'all' || row.getAttribute('data-series') === series;
          row.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (countEl) countEl.textContent = `${visible} of ${rows.length} factory sizes shown`;
        buttons.forEach((b) => {
          const isActive = (b.getAttribute('data-series') || 'all') === series;
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          b.classList.toggle(ACTIVE[0], isActive);
          b.classList.toggle(ACTIVE[1], isActive);
          b.classList.toggle(ACTIVE[2], isActive);
          b.classList.toggle(IDLE[0], !isActive);
          b.classList.toggle(IDLE[1], !isActive);
          b.classList.toggle(IDLE[2], !isActive);
        });
      }

      buttons.forEach((b) => {
        b.addEventListener('click', () => apply(b.getAttribute('data-series') || 'all'));
      });
      apply('all');
    })();
  </script>
</Layout>

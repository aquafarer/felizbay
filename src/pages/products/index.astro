---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Image from '~/components/common/Image.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

import { SITE } from 'astrowind:config';
import { getProducts, isProductsEnabled, isProductsListEnabled } from '~/utils/products';
import { PRODUCT_LIST, getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';

const products = await getProducts();
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();

/** Filter tags per product slug — By Shape / By Use / By Space / By Features */
const filterTags: Record<string, string[]> = {
  'rectangular-drop-stitch-pool': [
    'shape-rectangular',
    'use-family',
    'use-leisure',
    'space-medium',
    'space-large',
    'feat-accessories',
  ],
  'round-blue-drop-stitch-pool': [
    'shape-round',
    'use-family',
    'use-leisure',
    'space-compact',
    'space-medium',
    'space-large',
    'feat-accessories',
  ],
  'round-grey-drop-stitch-pool': [
    'shape-round',
    'use-family',
    'use-leisure',
    'space-compact',
    'space-medium',
    'space-large',
    'feat-accessories',
  ],
  'hot-tub-square-rect': [
    'shape-square',
    'use-soaking',
    'use-leisure',
    'space-compact',
    'space-medium',
    'feat-seats',
    'feat-insulated',
  ],
  'hot-tub-round': ['shape-round', 'use-soaking', 'use-leisure', 'space-compact', 'feat-seats', 'feat-insulated'],
};

const filterGroups: Array<{ label: string; filters: Array<{ id: string; text: string }> }> = [
  {
    label: 'By Shape',
    filters: [
      { id: 'shape-round', text: 'Round' },
      { id: 'shape-rectangular', text: 'Rectangular' },
      { id: 'shape-square', text: 'Square' },
    ],
  },
  {
    label: 'By Use',
    filters: [
      { id: 'use-family', text: 'Family Relaxation' },
      { id: 'use-leisure', text: 'Backyard Leisure' },
      { id: 'use-soaking', text: 'Outdoor Soaking' },
    ],
  },
  {
    label: 'By Space',
    filters: [
      { id: 'space-compact', text: 'Compact Spaces' },
      { id: 'space-medium', text: 'Medium Gardens' },
      { id: 'space-large', text: 'Large Outdoor Areas' },
    ],
  },
  {
    label: 'By Features',
    filters: [
      { id: 'feat-seats', text: 'Built-in Seats' },
      { id: 'feat-insulated', text: 'Insulated Bottom' },
      { id: 'feat-accessories', text: 'Available Accessories' },
    ],
  },
];

const cardData = await Promise.all(
  products.map(async (p) => {
    const image = (await findImage(p.image)) as string | undefined;
    const spec = (needle: string) =>
      p.specs?.find((s: { label: string }) => s.label.toLowerCase().includes(needle))?.value ?? '';
    const sizeRange = spec('size range');
    const isSpa = p.slug.startsWith('hot-tub');
    const highlights = [
      spec('wall thickness'),
      spec('inflation time') || spec('setup time'),
      isSpa ? spec('seats') : spec('included'),
    ].filter(Boolean);
    return {
      title: p.title,
      summary: p.summary,
      href: getPermalink(p.permalink, 'product'),
      image,
      alt: p.title,
      sizeRange,
      highlights,
      price: p.price?.amount ? (p.sku ? `$${p.price.amount}` : `From $${p.price.amount}`) : '',
      isRetail: Boolean(p.sku),
      inStock: p.inStock,
      tags: filterTags[p.slug] ?? [],
      isSpa,
    };
  })
);

const catalogSections = [
  {
    id: 'pool',
    title: 'Swimming Pools',
    intro:
      'Family-size drop stitch swimming pools with rigid high-pressure walls — from compact patio sizes to large garden models. Pump, cover, repair kit, and storage bag included.',
    cards: cardData.filter((c) => !c.isSpa),
  },
  {
    id: 'spa',
    title: 'SPA Soaking Tubs',
    intro:
      'Compact drop-stitch soaking tubs with built-in inflatable seats and an insulated bottom. Compatible with selected external heating systems, sold separately — confirm equipment compatibility before purchase.',
    cards: cardData.filter((c) => c.isSpa),
  },
].filter((section) => section.cards.length > 0);

const metadata = merge(
  {
    title: `Drop Stitch Inflatable Pools — Compare Shapes & Sizes | ${SITE.name}`,
    description: `Compare Felizbay drop stitch inflatable pools by shape, size, and features — rectangular and round pools plus SPA tubs. Find the right pool for your backyard.`,
    canonical: getCanonical(getPermalink(PRODUCT_LIST)),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@type': 'ItemList',
      name: 'Felizbay Inflatable Pools',
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: String(getCanonical(getPermalink(p.permalink, 'product'))),
        name: p.title,
      })),
    }}
  />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Shop Pools</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Explore Felizbay Drop Stitch Inflatable Pools
      </h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        Compare shapes, sizes, and features to find the right pool for your backyard or outdoor space.
      </p>
      <p class="mt-2 mx-auto text-sm text-gray-500 dark:text-slate-400">
        5 product families · 4 collections · 48 standard SKUs — see the full size and price matrix in the
        <a href="/products/specs" class="text-primary dark:text-blue-400 hover:underline">specs table</a>.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/products/compare"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-white text-sm font-semibold rounded-full hover:bg-primary/90 transition-colors"
        >
          <Icon name="tabler:arrows-diff" class="w-4 h-4" />
          Compare Models
        </a>
        <a
          href="/products/specs"
          class="inline-flex items-center gap-2 px-6 py-2.5 border border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 text-sm font-semibold rounded-full hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          <Icon name="tabler:table" class="w-4 h-4" />
          Full Specs &amp; Price Table
        </a>
      </div>
    </header>

    <!-- Filters -->
    <div class="mb-10 space-y-4" data-filters>
      {
        filterGroups.map((group) => (
          <div class="flex flex-wrap items-center justify-center gap-2" data-filter-group={group.label}>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mr-1">
              {group.label}:
            </span>
            {group.filters.map((f) => (
              <button
                type="button"
                data-filter={f.id}
                class="filter-chip inline-flex items-center px-4 py-2 rounded-full text-sm font-medium border transition-colors bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700"
              >
                {f.text}
              </button>
            ))}
          </div>
        ))
      }
      <div class="text-center">
        <button
          type="button"
          data-filter-reset
          class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-800 dark:hover:text-slate-200 transition-colors"
        >
          <Icon name="tabler:x" class="w-4 h-4" />
          Clear filters
        </button>
      </div>
      <p class="text-center text-sm text-gray-400 dark:text-slate-500" data-filter-count>
        Showing all {totalCount} pools
      </p>
    </div>

    <!-- Product sections: Swimming Pools vs SPA Soaking Tubs -->
    {
      catalogSections.map((section) => (
        <div class="mb-12 md:mb-16" data-catalog-section={section.id}>
          <div class="mb-6 max-w-3xl">
            <h2 class="text-2xl md:text-3xl font-bold font-heading dark:text-slate-100">{section.title}</h2>
            <p class="mt-2 text-sm md:text-base text-gray-500 dark:text-slate-400">{section.intro}</p>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-product-grid>
            {section.cards.map((card) => (
              <article
                class="card-premium group relative flex flex-col bg-white dark:bg-slate-900 overflow-hidden rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm hover:shadow-xl transition-shadow"
                data-tags={card.tags.join(' ')}
              >
                <a href={card.href} class="block relative aspect-[4/3] bg-gray-50 dark:bg-slate-800 overflow-hidden">
                  {card.image ? (
                    <Image
                      src={card.image}
                      alt={card.alt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      widths={[480, 768, 1024]}
                      width={640}
                      height={480}
                      sizes="(max-width: 768px) 100vw, 33vw"
                      format="webp"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-gray-300 dark:text-slate-700">
                      <Icon name="tabler:photo" class="w-16 h-16" />
                    </div>
                  )}
                </a>
                <div class="p-6 flex flex-col flex-1">
                  <h3 class="text-lg font-semibold leading-snug font-heading dark:text-slate-100 mb-2">
                    <a href={card.href} class="hover:text-primary transition-colors">
                      {card.title}
                    </a>
                  </h3>
                  {card.sizeRange && (
                    <p class="text-sm font-medium text-primary dark:text-blue-400 mb-2">{card.sizeRange}</p>
                  )}
                  {card.highlights.length > 0 && (
                    <ul class="text-sm text-gray-500 dark:text-slate-400 space-y-1 mb-3">
                      {card.highlights.map((h) => (
                        <li class="flex items-start gap-2">
                          <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-green-500 shrink-0" />
                          <span>{h}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <div class="mt-auto pt-3 border-t border-gray-100 dark:border-slate-800">
                    <div class="flex items-baseline justify-between gap-2">
                      {card.price && (
                        <span class="text-2xl font-bold text-gray-900 dark:text-slate-100">
                          {card.price}
                          <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 ml-1">
                            {card.isRetail ? 'Retail' : 'Wholesale FOB'}
                          </span>
                        </span>
                      )}
                      {card.isRetail && card.inStock && (
                        <span class="text-xs font-medium text-green-600">Available to order</span>
                      )}
                    </div>
                    <a
                      href={card.href}
                      class="mt-3 flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
                    >
                      View Details
                      <Icon name="tabler:arrow-right" class="w-4 h-4" />
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }

    <div class="mt-10 text-center hidden" data-empty-state>
      <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4 text-gray-300 dark:text-slate-600" />
      <p class="text-lg text-gray-500 dark:text-slate-400">No pools match those filters — try clearing them.</p>
    </div>
  </section>

  <script>
    (function () {
      const chips = document.querySelectorAll<HTMLElement>('[data-filter]');
      const reset = document.querySelector<HTMLElement>('[data-filter-reset]');
      const count = document.querySelector<HTMLElement>('[data-filter-count]');
      const empty = document.querySelector<HTMLElement>('[data-empty-state]');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-grid] article[data-tags]'));
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-catalog-section]'));
      if (cards.length === 0) return;
      const active: Record<string, string> = {};
      function apply(): void {
        const groups = Object.keys(active).filter((g) => active[g]);
        let visible = 0;
        for (const card of cards) {
          const tags = (card.getAttribute('data-tags') || '').split(' ');
          const show = groups.every((g) => tags.includes(active[g]));
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        for (const section of sections) {
          const sectionCards = Array.from(section.querySelectorAll<HTMLElement>('article[data-tags]'));
          const anyVisible = sectionCards.some((c) => c.style.display !== 'none');
          section.style.display = anyVisible ? '' : 'none';
        }
        if (count) count.textContent = `Showing ${visible} of ${cards.length} pools`;
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      }
      function setChip(chip: HTMLElement, on: boolean): void {
        chip.classList.toggle('bg-primary', on);
        chip.classList.toggle('text-white', on);
        chip.classList.toggle('border-primary', on);
        chip.classList.toggle('dark:bg-blue-500', on);
        chip.classList.toggle('dark:border-blue-500', on);
      }
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const groupEl = chip.closest('[data-filter-group]');
          const group = groupEl?.getAttribute('data-filter-group') || '';
          const wasOn = active[group] === chip.getAttribute('data-filter');
          if (wasOn) {
            delete active[group];
          } else {
            const prev = groupEl?.querySelector<HTMLElement>('[data-filter].bg-primary');
            if (prev) setChip(prev, false);
            active[group] = chip.getAttribute('data-filter') || '';
          }
          setChip(chip, !wasOn);
          apply();
        });
      });
      if (reset) {
        reset.addEventListener('click', () => {
          for (const key of Object.keys(active)) delete active[key];
          chips.forEach((chip) => setChip(chip, false));
          apply();
        });
      }
    })();
  </script>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Felizbay product catalog: premium drop-stitch inflatable swimming pools in rectangular and round shapes plus SPA
      soaking tubs. Quick tool-free setup, puncture-resistant reinforced material, compact off-season storage, and
      safety-conscious design referencing EN 16582-1 and ASTM F2666. Retail and wholesale inquiries welcome at
      info@felizbay.com.
    </p>
  </section>
</Layout>

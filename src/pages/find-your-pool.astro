/**
 * Question order per docx §2/§9: purpose FIRST and it truly splits the flow
 * (personal → retail candidates only; business → project-family candidates).
 * 'features' is multi-select ("Ambient-water use" clears the rest).
 * 'who' is explanation-only — it never filters results (docx §9).
 */
const questions: Array<{
  qid: string;
  label: string;
  hint?: string;
  filter: 'tag' | 'info' | 'features';
  filters: Array<{ id: string; text: string }>;
}> = [
  {
    qid: 'purpose',
    label: 'Is this for personal use or a business project?',
    filter: 'info',
    filters: [
      { id: 'purpose-personal', text: 'Personal / family use' },
      { id: 'purpose-business', text: 'Business or rental project' },
    ],
  },
  {
    qid: 'install',
    label: 'Where will it be installed?',
    filter: 'info',
    filters: [
      { id: 'install-ground', text: 'Ground level (lawn, patio)' },
      { id: 'install-raised', text: 'Raised deck or balcony' },
    ],
  },
  {
    qid: 'use',
    label: 'What will you use it for?',
    filter: 'tag',
    filters: [
      { id: 'use-play', text: 'Swim & Play' },
      { id: 'use-soak', text: 'Relax & Soak' },
      { id: 'use-entertain', text: 'Entertain Guests' },
      { id: 'use-cold', text: 'Cold Plunge & Recovery' },
      { id: 'use-fitness', text: 'Water Fitness' },
      { id: 'use-pets', text: 'Pet Splash' },
    ],
  },
  {
    qid: 'features',
    label: 'Which features do you require?',
    hint: 'Select all that apply — picking “Ambient-water use” clears the others.',
    filter: 'features',
    filters: [
      { id: 'ambient', text: 'Ambient-water use' },
      { id: 'heated', text: 'Heated soaking' },
      { id: 'bubble', text: 'Bubble system' },
      { id: 'massage', text: 'Water-jet massage' },
    ],
  },
  {
    qid: 'space',
    label: 'Roughly how much total clear, level area do you have?',
    hint: 'Skip this if you enter exact measurements below.',
    filter: 'tag',
    filters: [
      { id: 'space-compact', text: 'Compact (under 3 m)' },
      { id: 'space-medium', text: 'Medium (3 – 5 m)' },
      { id: 'space-large', text: 'Large (over 5 m)' },
    ],
  },
  {
    qid: 'who',
    label: 'Who is it mainly for?',
    hint: 'Explanation only — this never filters the results.',
    filter: 'info',
    filters: [
      { id: 'who-family', text: 'Kids & Family' },
      { id: 'who-adults', text: 'Adults' },
      { id: 'who-mixed', text: 'Guests / Mixed' },
    ],
  },
];

const metadata = merge(
  {
    title: `Find Your Pool | ${SITE.name}`,
    description: `Personal buyers are matched only against the three fixed-size Felizbay retail sets sold online; business projects review candidate factory families from the catalog — with honest no-fit, insufficient-data and review-required states.`,
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;
---

<Layout metadata={metadata} breadcrumbs={[{ name: 'Find Your Pool' }]}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl" id="finder-root">
    <header class="mb-10 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Pool Finder</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">Find Your Pool</h1>
      <p class="mt-4 text-xl text-gray-500 dark:text-slate-400 font-medium">
        One questionnaire, two honest paths. Personal buyers are matched only against the three fixed-size retail sets
        sold online; business projects review candidate factory families from the Felizbay catalog. When nothing fits —
        or the data is not confirmed yet — we say so instead of forcing a match.
      </p>
    </header>

    <!-- Questionnaire (purpose first — it splits retail vs business) -->
    <div class="mb-10 space-y-5" data-finder>
      {questions.map((q) => (
        <div class="text-center" data-qid={q.qid} data-filter={q.filter}>
          <p class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2">
            {q.label}
            {q.hint && <span class="font-normal text-gray-400 dark:text-slate-500"> ({q.hint})</span>}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-2">
            {q.filters.map((f) => (
              <button
                type="button"
                data-answer={f.id}
                class="finder-chip inline-flex items-center px-5 py-2.5 rounded-full text-sm font-medium border transition-colors bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700"
              >
                {f.text}
              </button>
            ))}
          </div>
        </div>
      ))}

      <!-- Total clear, level area (docx P0-2: one unified input definition) -->
      <div class="text-center" data-qid="dims" data-filter="dim">
        <p class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2">
          Total clear, level area available
          <span class="font-normal text-gray-400 dark:text-slate-500">
            (optional — takes priority over the buckets)
          </span>
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <label for="finder-len" class="sr-only">
            Available length in meters
          </label>
          <input
            id="finder-len"
            type="number"
            min="0"
            max="30"
            step="0.1"
            inputmode="decimal"
            placeholder="Length m"
            data-dim-l
            class="w-28 px-4 py-2.5 rounded-full text-sm border bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50"
          />
          <span class="text-sm text-gray-400 dark:text-slate-500">×</span>
          <label for="finder-wid" class="sr-only">
            Available width in meters
          </label>
          <input
            id="finder-wid"
            type="number"
            min="0"
            max="30"
            step="0.1"
            inputmode="decimal"
            placeholder="Width m"
            data-dim-w
            class="w-28 px-4 py-2.5 rounded-full text-sm border bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50"
          />
        </div>
        <p class="mt-2 text-xs text-gray-400 dark:text-slate-500 max-w-xl mx-auto">
          Enter the full length and width available for the pool, access and required equipment. Do not subtract
          clearance yourself — required clearance depends on the selected model, equipment layout and applicable local
          requirements.
        </p>
      </div>

      <!-- Delivery country -->
      <div class="text-center" data-qid="country" data-filter="info">
        <p class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2">
          Delivery country <span class="font-normal text-gray-400 dark:text-slate-500">(optional)</span>
        </p>
        <label for="finder-country" class="sr-only">
          Delivery country
        </label>
        <input
          id="finder-country"
          type="text"
          maxlength="60"
          placeholder="e.g. Germany"
          data-country
          class="w-56 px-4 py-2.5 rounded-full text-sm border bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50"
        />
      </div>

      <div class="text-center">
        <button
          type="button"
          data-finder-reset
          class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-800 dark:hover:text-slate-200 transition-colors"
        >
          <Icon name="tabler:refresh" class="w-4 h-4" />
          Start over
        </button>
      </div>
    </div>

    <!-- Contextual notices (routing, input guidance, delivery) -->
    <div class="mb-8 space-y-3 empty:hidden" data-finder-notices aria-live="polite"></div>

    <!-- Result status panel: unsupported / no-fit / review-required / compatibility (docx §6) -->
    <div
      class="hidden mb-8 rounded-2xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 p-6 md:p-8 text-center"
      data-finder-status
    >
      <h2 class="text-lg font-semibold font-heading text-amber-900 dark:text-amber-100" data-status-title></h2>
      <p class="mt-2 text-sm text-amber-800 dark:text-amber-200 leading-relaxed max-w-2xl mx-auto" data-status-text></p>
      <div class="mt-5">
        <a
          data-status-cta
          href="/contact/"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-semibold rounded-lg transition-colors"
        ></a>
      </div>
    </div>

    <!-- Personal path: retail sets (shown when purpose = personal) -->
    <div id="retail-results" style="display:none" class="mb-16 md:mb-20 scroll-mt-24">
      <div class="mb-6 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Retail Sets</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading dark:text-slate-100">Shop a Retail Set</h2>

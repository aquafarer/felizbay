                  <thead>
                    <tr class="bg-gray-50 dark:bg-slate-800/60 text-left text-[10px] uppercase tracking-wider text-gray-400 dark:text-slate-500">
                      <th class="px-2.5 py-2 font-semibold">Item</th>

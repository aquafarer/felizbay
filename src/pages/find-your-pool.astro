    <!-- No-JS fallback: reveal the retail sets (JS hides #retail-results until purpose = personal) -->
    <noscript>
      <style>
        #retail-results {
          display: block !important;
        }
      </style>
    </noscript>
  </section>

  <script>
    (function () {
      interface FitOption {
        d?: number;
        l?: number;
        w?: number;
      }

      /** Engine 2 model info serialized from the build-time catalog SSOT */
      interface ModelInfo {
        id: string;
        size: string;
        fob: number;
        fit: FitOption;
      }

      const root = document.getElementById('finder-root');
      if (!root) return;
      const grid = root.querySelector<HTMLElement>('[data-setup-grid]');
      const retailGrid = root.querySelector<HTMLElement>('[data-retail-grid]');
      const retailSection = document.getElementById('retail-results');
      const businessSection = document.getElementById('project-planner');
      const chips = root.querySelectorAll<HTMLElement>('[data-answer]');
      const reset = root.querySelector<HTMLElement>('[data-finder-reset]');
      const notices = root.querySelector<HTMLElement>('[data-finder-notices]');
      const statusPanel = root.querySelector<HTMLElement>('[data-finder-status]');
      const statusTitle = root.querySelector<HTMLElement>('[data-status-title]');
      const statusText = root.querySelector<HTMLElement>('[data-status-text]');
      const statusCta = root.querySelector<HTMLAnchorElement>('[data-status-cta]');
      const lenEl = root.querySelector<HTMLInputElement>('[data-dim-l]');
      const widEl = root.querySelector<HTMLInputElement>('[data-dim-w]');
      const countryEl = root.querySelector<HTMLInputElement>('[data-country]');

      const sel: Record<string, string> = {};
      const features = new Set<string>();

      // --- Anonymous advisor analytics (GEO KPI: filter → click → no-match) ---
      // Coarse answer buckets only, no PII — the free-text country field is
      // never included. Each event is sent at most once per answer-set per
      // page session; failures never break the finder.
      const sentEvents = new Set<string>();
      let trackTimer: ReturnType<typeof setTimeout> | null = null;

      function trackLang(): string {
        const l = (document.documentElement.lang || 'en').toLowerCase();
        return /^[a-z]{2}(-[a-z]{2})?$/.test(l) ? l : 'en';
      }

      function answerSnapshot(): Record<string, string> {
        const a: Record<string, string> = {};
        for (const k of ['purpose', 'install', 'use', 'space', 'who']) {
          if (sel[k]) a[k] = sel[k];
        }
        if (features.size > 0) a.features = Array.from(features).sort().join('+');
        if (dimsState() === 'valid') {
          const d = readDims();
          a.dims = `${d.L}x${d.W}`;
        }
        return a;
      }

      function sendTrack(type: string, product: string | null, answers: Record<string, string>): void {
        try {
          const body = JSON.stringify({ type, product, lang: trackLang(), answers });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track', new Blob([body], { type: 'application/json' }));
          } else {
            void fetch('/api/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body,
              keepalive: true,
            });
          }
        } catch {
          /* analytics must never break the finder */
        }
      }

      function queueTrack(visible: number, hasInput: boolean): void {
        if (trackTimer !== null) clearTimeout(trackTimer);
        trackTimer = setTimeout(() => {
          trackTimer = null;
          if (!hasInput) return;
          const answers = answerSnapshot();
          const type = visible === 0 ? 'no_match' : 'quiz_filter';
          const key = `${type}|${JSON.stringify(answers)}`;
          if (sentEvents.has(key)) return;
          sentEvents.add(key);
          sendTrack(type, null, answers);
        }, 900);
      }

      root.addEventListener('click', (ev: MouseEvent) => {
        const target = ev.target as HTMLElement | null;
        const anchor = target && target.closest ? target.closest('a') : null;
        if (!anchor) return;
        const href = anchor.getAttribute('href') || '';
        const productMatch = href.match(/^\/products\/([a-z0-9-]+)/);
        const ideaMatch = href.match(/^\/pool-ideas\/([a-z0-9-]+)/);
        if (productMatch) {
          sendTrack('result_click', productMatch[1], { ...answerSnapshot(), target: 'shop' });
        } else if (ideaMatch) {
          sendTrack('result_click', ideaMatch[1], { ...answerSnapshot(), target: 'guide' });
        } else if (href.indexOf('/contact/?project=') === 0) {
          sendTrack('result_click', 'project-review', { ...answerSnapshot(), target: 'review' });
        } else if (href.indexOf('/contact/') === 0) {
          sendTrack('result_click', 'contact-advice', { ...answerSnapshot(), target: 'advice' });
        }
      });

      // --- Exact-area input: four states (none / partial / invalid / valid) ---
      function readRaw(el: HTMLInputElement | null): string {
        return el ? el.value.trim() : '';
      }

      function dimsState(): 'none' | 'partial' | 'invalid' | 'valid' {
        const rl = readRaw(lenEl);
        const rw = readRaw(widEl);
        const hasL = rl !== '';
        const hasW = rw !== '';
        if (!hasL && !hasW) return 'none';
        if (hasL !== hasW) return 'partial';
        const l = parseFloat(rl);
        const w = parseFloat(rw);
        if (!isFinite(l) || !isFinite(w) || l <= 0 || w <= 0) return 'invalid';
        return 'valid';
      }

      function readDims(): { L: number; W: number } {
        return {
          L: parseFloat(lenEl ? lenEl.value : '0'),
          W: parseFloat(widEl ? widEl.value : '0'),
        };
      }

      // --- Fit math: circle = diameter vs both sides; rect = 90° rotation allowed ---
      function optFits(o: FitOption, L: number, W: number): boolean {
        if (typeof o.d === 'number') return o.d <= L && o.d <= W;
        if (typeof o.l === 'number' && typeof o.w === 'number') {
          return (o.l <= L && o.w <= W) || (o.w <= L && o.l <= W);
        }
        return true;
      }

      function parseOpts(card: HTMLElement): FitOption[] {
        try {
          return JSON.parse(card.getAttribute('data-opts') || '[]') as FitOption[];
        } catch {
          return [];
        }
      }

      function cardFitsDims(card: HTMLElement, L: number, W: number): boolean {
        return parseOpts(card).some((o) => optFits(o, L, W));
      }

      function optLabel(o: FitOption): string {
        if (typeof o.d === 'number') return `Ø ${o.d} m footprint`;
        if (typeof o.l === 'number' && typeof o.w === 'number') return `${o.l} × ${o.w} m footprint`;
        return '';
      }

      function makeBanner(tone: 'amber' | 'sky', text: string, link?: { href: string; label: string }): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className =
          tone === 'amber'
            ? 'rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-5 py-4 text-sm leading-relaxed text-amber-900 dark:text-amber-200'
            : 'rounded-xl border border-sky-200 dark:border-sky-900/50 bg-sky-50 dark:bg-sky-950/30 px-5 py-4 text-sm leading-relaxed text-sky-900 dark:text-sky-200';
        const p = document.createElement('p');
        p.textContent = text;
        wrap.appendChild(p);
        if (link) {
          const a = document.createElement('a');
          a.href = link.href;
          a.textContent = link.label;
          a.className = 'mt-1.5 inline-block font-semibold underline underline-offset-2';
          wrap.appendChild(a);
        }
        return wrap;
      }

      function renderNotices(ds: 'none' | 'partial' | 'invalid' | 'valid'): void {
        if (!notices) return;
        notices.replaceChildren();
        if (ds === 'partial') {
          notices.appendChild(
            makeBanner(
              'sky',
              'Enter both length and width to check the exact fit — until then the rough area buckets apply.'
            )
          );
        }
        if (ds === 'invalid') {
          notices.appendChild(
            makeBanner(
              'amber',
              'Enter valid positive numbers — 0, negative or non-numeric values cannot be checked, so no exact-fit recommendation is made.'
            )
          );
        }
        if (sel['purpose'] === 'purpose-business') {
          notices.appendChild(
            makeBanner(
              'sky',
              'Business project: the families below are candidates for review — we confirm model, equipment and suitability per project. Send your country, site, planned usage and timeline.',
              { href: '/contact/', label: 'Start a project review →' }
            )
          );
        }
        if (sel['purpose'] === 'purpose-personal') {
          notices.appendChild(
            makeBanner(
              'sky',
              'Personal path: showing the retail sets sold online as single pieces. If you need a size the retail sets do not cover (the factory range spans Ø 2–10 m rounds and up to 6 × 5 m rectangles), switch the first answer to review factory families — those are quoted FOB per 20 pcs, so they suit projects and group buying rather than single-piece purchase.',
              { href: '#project-planner', label: 'See the full factory range →' }
            )
          );
        }
        if (countryEl && countryEl.value.trim()) {
          const c = countryEl.value.trim();
          notices.appendChild(
            makeBanner(
              'sky',
              `Before ordering, confirm delivery to ${c}. Delivery availability and shipping cost are confirmed per order — send us your delivery address and we will confirm before you commit.`,
              { href: '/contact/', label: 'Confirm delivery →' }
            )
          );
        }
      }

      const TAG_TEXT: Record<string, string> = {
        'use-play': 'swim & play use',
        'use-soak': 'relax & soak use',
        'use-entertain': 'entertaining guests',
        'use-cold': 'cold-plunge & recovery use',
        'use-fitness': 'water fitness',
        'use-pets': 'pet splash use',
        'who-family': 'for kids & family',
        'who-adults': 'for adults',
        'who-mixed': 'for mixed guests',
      };

      const INSTALL_TEXT: Record<string, string> = {
        'install-ground': 'ground-level install',
        'install-raised': 'raised install — engineer sign-off required',
      };

      function parseModels(card: HTMLElement): ModelInfo[] {
        try {
          return JSON.parse(card.getAttribute('data-models') || '[]') as ModelInfo[];
        } catch {
          return [];
        }
      }

      function renderWhy(card: HTMLElement, show: boolean, dimsValid: boolean, L: number, W: number): void {
        const why = card.querySelector<HTMLElement>('[data-why]');
        if (!why) return;
        const parts: string[] = [];
        if (show && dimsValid) {
          // Engine 2: business cards name the exact fitting catalog items with FOB
          const models = parseModels(card);
          const fitting = models.filter((m) => optFits(m.fit, L, W));
          if (fitting.length > 0) {
            const modelText = fitting
              .slice(0, 2)
              .map((m) => `${m.id} — ${m.size} m, FOB $${Math.round(m.fob)}/pc @ 20 pcs`)
              .join(' or ');
            parts.push(`${modelText} fits your ${L} × ${W} m clear area`);
          } else {
            const fits = parseOpts(card)
              .filter((o) => optFits(o, L, W))
              .map(optLabel)
              .filter(Boolean);
            if (fits.length > 0) parts.push(`${fits.slice(0, 2).join(' or ')} fits your ${L} × ${W} m clear area`);
          }
        }
        const useT = TAG_TEXT[sel['use'] || ''];
        if (useT) parts.push(useT);
        const whoT = TAG_TEXT[sel['who'] || ''];
        if (whoT) parts.push(whoT);
        const instT = INSTALL_TEXT[sel['install'] || ''];
        if (instT) parts.push(instT);
        if (show && parts.length > 0) {
          why.textContent = `Why it fits: ${parts.join(' · ')}`;
          why.classList.remove('hidden');
        } else {
          why.classList.add('hidden');
        }
      }

      // --- Result status panel (docx §6: no-fit / unsupported / review / compatibility) ---
      function setStatus(
        state: 'none' | 'unsupported' | 'nofit' | 'review' | 'compat',
        dimsValid: boolean,
        L: number,
        W: number,
        purpose: string
      ): void {
        if (!statusPanel) return;
        if (state === 'none') {
          statusPanel.classList.add('hidden');
          return;
        }
        let title: string;
        let text: string;
        let ctaHref: string;
        let ctaLabel: string;
        if (state === 'unsupported') {
          title = 'Unsupported feature';
          text = features.has('massage')
            ? 'We cannot confirm a standard massage-jet configuration for your requirements. None of our sets include massage jets — if jets are essential, we are not the right fit.'
            : 'None of our sets include a bubble system as a standard, verified feature. If a bubble system is essential, request compatibility advice before ordering.';
          ctaHref = '/contact/?topic=compatibility';
          ctaLabel = 'Request Compatibility Advice';
        } else if (state === 'nofit') {
          title = dimsValid ? 'No fit for this space' : 'No confirmed match for your answers';
          text = dimsValid
            ? `None of the ${purpose === 'purpose-personal' ? 'retail sets' : 'recommended sizes'} fit ${L} × ${W} m. Our smallest footprints start around 1.5 × 1.5 m. Revise your measurements or ask us about custom OEM sizes — do not reduce required installation clearance to force a fit.`
            : 'No standard model matches your answers. Space, safety and required features are not relaxed to force a fit — revise an answer or ask for product advice.';
          ctaHref = '/contact/';
          ctaLabel = 'Ask for Product Advice';
        } else if (state === 'review') {
          title = 'Installation review required';
          text =
            'A filled pool weighs roughly 1 t per m³ of water — a raised deck or balcony must be rated by a structural professional before anything is ordered. The candidates shown are for review only: installation suitability is not confirmed, and drainage must be planned first.';
          ctaHref = '/guides/how-much-does-a-filled-inflatable-pool-weigh/';
          ctaLabel = 'See filled-weight math by size →';
        } else {
          title = 'Compatibility review required';
          text =
            'Heated soaking needs an external heater (sold separately) — no model-level heater configuration has been verified yet. The soak-tub candidates shown pair with external heaters, but compatibility is confirmed per order, not automatically.';
          ctaHref = '/contact/?topic=compatibility';
          ctaLabel = 'Request Compatibility Advice';
        }
        if (statusTitle) statusTitle.textContent = title;
        if (statusText) statusText.textContent = text;
        if (statusCta) {
          statusCta.href = ctaHref;
          statusCta.textContent = ctaLabel;
        }
        statusPanel.classList.remove('hidden');
      }

      // --- Rule pipeline (docx §9, simplified to the front-end subset) ---
      function apply(): void {
        const ds = dimsState();
        const dimsValid = ds === 'valid';
        const d = dimsValid ? readDims() : { L: 0, W: 0 };
        const L = d.L;
        const W = d.W;
        const p = sel['purpose'] || '';
        const unsupported = features.has('bubble') || features.has('massage');
        const heated = features.has('heated');
        const raised = sel['install'] === 'install-raised';
        const useSel = sel['use'] || '';
        const spaceSel = sel['space'] || '';

        // 1. Retail / business routing (P0-1)
        if (retailSection) retailSection.style.display = p === 'purpose-personal' ? '' : 'none';
        if (businessSection) businessSection.style.display = p === 'purpose-personal' ? 'none' : '';

        // 2. Business candidates (P0-1: family review, never a confirmed recommendation)
        let bizVisible = 0;
        if (grid) {
          const cards = Array.from(grid.children) as HTMLElement[];
          for (const card of cards) {
            const tags = (card.getAttribute('data-tags') || '').split(' ');
            let show = true;
            if (unsupported) {
              show = false;
            } else {
              if (heated && card.getAttribute('data-heat') !== 'candidate') show = false;
              if (show && useSel && !tags.includes(useSel)) show = false;
              if (show && dimsValid) {
                show = cardFitsDims(card, L, W);
              } else if (show && spaceSel && !tags.includes(spaceSel)) {
                show = false;
              }
            }
            card.style.display = show ? '' : 'none';
            renderWhy(card, show, dimsValid, L, W);
            if (show) bizVisible++;
          }
        }

        // 3. Retail candidates (P0-1: only the three retail SKUs; P1: sets
        //    without published dimensions are never auto-matched)
        let retailVisible = 0;
        if (retailGrid) {
          const cards = Array.from(retailGrid.children) as HTMLElement[];
          for (const card of cards) {
            const tags = (card.getAttribute('data-tags') || '').split(' ');
            let show = true;
            if (unsupported) {
              show = false;
            } else {
              if (heated && card.getAttribute('data-heat') !== 'candidate') show = false;
              if (show && useSel && !tags.includes(useSel)) show = false;
              if (show && dimsValid && card.getAttribute('data-dims-known') === 'true') {
                show = cardFitsDims(card, L, W);
              }
            }
            card.style.display = show ? '' : 'none';
            renderWhy(card, show, dimsValid, L, W);
            if (show) retailVisible++;
          }
        }

        const activeVisible = p === 'purpose-personal' ? retailVisible : bizVisible;
        const hasInput =
          Object.keys(sel).length > 0 || features.size > 0 || dimsValid || ds === 'invalid' || ds === 'partial';

        // 4. Status panel priority: unsupported > no-fit > install review > heated compat
        let state: 'none' | 'unsupported' | 'nofit' | 'review' | 'compat' = 'none';
        if (unsupported) {
          state = 'unsupported';
        } else if (activeVisible === 0 && (dimsValid || useSel || spaceSel || heated)) {
          state = 'nofit';
        } else if (raised) {
          state = 'review';
        } else if (heated) {
          state = 'compat';
        }
        setStatus(state, dimsValid, L, W, p);

        renderNotices(ds);
        queueTrack(activeVisible, hasInput);
      }

      function setChip(chip: HTMLElement, on: boolean): void {
        chip.classList.toggle('bg-primary', on);
        chip.classList.toggle('text-white', on);
        chip.classList.toggle('border-primary', on);
        chip.classList.toggle('dark:bg-blue-500', on);
        chip.classList.toggle('dark:border-blue-500', on);
      }

      function syncFeatureChips(): void {
        if (!root) return;
        const fGroup = root.querySelector<HTMLElement>('[data-qid="features"]');
        if (!fGroup) return;
        fGroup.querySelectorAll<HTMLElement>('[data-answer]').forEach((c) => {
          setChip(c, features.has(c.getAttribute('data-answer') || ''));
        });
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const groupEl = chip.closest<HTMLElement>('[data-qid]');
          const qid = groupEl?.getAttribute('data-qid') || '';
          const id = chip.getAttribute('data-answer') || '';
          const filter = groupEl?.getAttribute('data-filter') || '';
          if (filter === 'features') {
            if (id === 'ambient') {
              if (features.has('ambient')) {
                features.clear();
              } else {
                features.clear();
                features.add('ambient');
              }
            } else {
              features.delete('ambient');
              if (features.has(id)) {
                features.delete(id);
              } else {
                features.add(id);
              }
            }
            syncFeatureChips();
          } else {
            const wasOn = sel[qid] === id;
            if (wasOn) {
              delete sel[qid];
              setChip(chip, false);
            } else {
              const prev = groupEl?.querySelector<HTMLElement>('[data-answer].bg-primary');
              if (prev) setChip(prev, false);
              sel[qid] = id;
              setChip(chip, true);
            }
          }
          apply();
        });
      });

      if (lenEl) lenEl.addEventListener('input', apply);
      if (widEl) widEl.addEventListener('input', apply);
      if (countryEl) countryEl.addEventListener('input', apply);

      if (reset) {
        reset.addEventListener('click', () => {
          for (const key of Object.keys(sel)) delete sel[key];
          features.clear();
          chips.forEach((chip) => setChip(chip, false));
          if (lenEl) lenEl.value = '';
          if (widEl) widEl.value = '';
          if (countryEl) countryEl.value = '';
          apply();
        });
      }
    })();
  </script>
</Layout>

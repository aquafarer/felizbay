interface FitOption {
  /** Round diameter in meters */
  d?: number;
  /** Rectangular length in meters */
  l?: number;
  /** Rectangular width in meters */
  w?: number;
}

/**
 * Engine 2 (docx §5): factory / project recommendations read the full 48-SKU
 * catalog (pool-catalog.ts SSOT) — every model listed on a business card is a
 * real catalog item with size, wall, packed weight and FOB reference pulled
 * at build time, so the finder, the wholesale price list and the compare
 * tables can never drift apart.
 */
interface CatalogModel {
  id: string;
  seriesId: string;
  size: string;
  wall: string;
  weightKg: number | null;
  fobUsd: number;
  fit: FitOption;
}

function parseCatalogFit(size: string): FitOption {
  const nums = size
    .replace('Ø', '')
    .split('×')
    .map((p) => parseFloat(p.trim()))
    .filter((n) => !Number.isNaN(n));
  if (size.includes('Ø') && nums.length >= 2) return { d: nums[0] };
  if (nums.length >= 3) return { l: nums[0], w: nums[1] };
  if (nums.length === 2) return { d: nums[0] };
  return {};
}

const catalogModels: CatalogModel[] = poolSeries.flatMap((s) =>
  s.items.map((it) => ({
    id: it.item,
    seriesId: s.id,
    size: it.size,
    wall: it.wall,
    weightKg: it.weightKg,
    fobUsd: it.fobUsd,
    fit: parseCatalogFit(it.size),
  }))
);

const modelById = new Map(catalogModels.map((m) => [m.id, m]));

interface RetailSet {
  title: string;
  price: string;
  sku: string;
  href: string;
  summary: string;
  included: string;
  size: string;
  important: string;
  /** Primary use tag (drives the personal-path use filter) */
  tags: string[];
  /** true when the exact external dimensions of this set are published */
  dimsKnown: boolean;
  /** Candidate for heated soaking via an external heater (confirmed per order) */
  heat?: boolean;
  opts: FitOption[];
}

interface PoolSetup {
  title: string;
  description: string;
  sizes: string;
  products: string;
  shopHref: string;
  ideaHref?: string;
  tags: string[];

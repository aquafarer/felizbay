    <div class="mt-14 text-center">
      <a
        href="/products/"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-white font-semibold rounded-full hover:bg-primary/90 transition-all"
      >
        Browse All Felizbay Pools
        <Icon name="tabler:arrow-right" class="w-5 h-5" />

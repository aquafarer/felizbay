---
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getProducts } from '~/utils/products';
import type { MetaData } from '~/types';

const metadata: MetaData = {
  title: `Best Drop Stitch Inflatable Pools: How to Choose | ${SITE.name}`,
  description:
    'Compare Felizbay drop stitch inflatable pools by size, capacity, pressure, and use — backyard swimming, small spaces, outdoor soaking, and vacation rentals. Find the right model for your space.',
  openGraph: { type: 'website' },
};

const products = await getProducts();

const collectionRows = [
  {
    href: '/products/round-blue-drop-stitch-pool',
    collection: 'Round Swimming Pools',
    sizes: 'Ø 2.0 – 10.0 m',
    capacity: 'Play depth to full swim depth',
    pressure: '4–5 PSI',
    price: 'From $299 retail',
    bestFor: 'Family swimming and play — widest size range',
  },
  {
    href: '/products/rectangular-drop-stitch-pool',
    collection: 'Rectangular Swimming Pools',
    sizes: '2 × 2 m – 6 × 5 m',
    capacity: 'Straight-sided swim space',
    pressure: '4–5 PSI',
    price: 'From $285.70 wholesale FOB',
    bestFor: 'Lap-style swimming and larger gatherings',
  },
  {
    href: '/products/hot-tub-round',
    collection: 'Round SPA Soaking Tubs',
    sizes: 'Ø 1.8 – 2.3 m',
    capacity: 'Seated soaking, built-in seats',
    pressure: '4–5 PSI',
    price: '$499 retail (Ø 2 × 0.8 m)',
    bestFor: 'Seated soaking and daily wind-downs',
  },
  {
    href: '/products/hot-tub-square-rect',
    collection: 'Square / Rect SPA Soaking Tubs',
    sizes: '1.5 × 1.5 m – 3 × 2 m',
    capacity: 'Seated soaking, compact footprint',
    pressure: '4–5 PSI',
    price: 'From $381 wholesale FOB',
    bestFor: 'Soaking in small courtyards and patios',
  },
];

const scenarios = [
  {
    icon: 'tabler:home',
    title: 'For Backyard Family Use',
    text: 'Choose a swimming pool based on the available outdoor space, usable water area, intended number of users, and the level of maintenance you can provide. Compare the dimensions and water capacity of each model before purchasing.',
    links: [
      { text: 'Round Pools', href: '/products/round-blue-drop-stitch-pool' },
      { text: 'Rectangular Pools', href: '/products/rectangular-drop-stitch-pool' },
      { text: 'Space Planning Guide', href: '/guides/how-much-space-do-you-need-for-an-inflatable-pool' },
    ],
  },
  {
    icon: 'tabler:layout-grid',
    title: 'For Smaller Outdoor Spaces',
    text: 'Consider a compact model that fits your available space while leaving room for safe access, drainage, and maintenance. Always verify that the installation surface can support the filled pool.',
    links: [
      { text: 'Small Backyard Ideas', href: '/pool-ideas/pools-for-small-backyards' },
      { text: 'Compact SPA Tubs', href: '/products/hot-tub-square-rect' },
    ],
  },
  {
    icon: 'tabler:ripple',
    title: 'For Outdoor Soaking',
    text: 'Explore seated soaking tubs with built-in seats and insulated bottoms. Some models can connect to compatible external heating equipment. Heating equipment and filtration systems are sold separately unless specifically included in the product package.',
    links: [
      { text: 'Round SPA Tubs', href: '/products/hot-tub-round' },
      { text: 'Square / Rect SPA Tubs', href: '/products/hot-tub-square-rect' },
    ],
  },
  {
    icon: 'tabler:beach',
    title: 'For Vacation Rentals and Hospitality',
    text: 'Consider the intended guest experience, installation requirements, water care, storage, and seasonal operating conditions. Commercial use may require additional maintenance, supervision, and local safety compliance.',
    links: [
      { text: 'Vacation Rental Guide', href: '/guides/inflatable-pools-for-vacation-rentals' },
      { text: 'For Businesses', href: '/for-businesses' },
    ],
  },
];

const recommendationRules = [
  {
    need: 'Backyard swimming',
    logic: 'Match a swimming pool model to your available space, pool dimensions, and the number of users.',
  },
  {
    need: 'Small outdoor space',
    logic: 'Choose a compact model, then confirm surrounding access space, load-bearing surface, and drainage.',
  },
  {
    need: 'Outdoor soaking',
    logic: 'Choose a seated SPA model and confirm compatibility with external heating equipment.',
  },
  {
    need: 'Vacation rental',
    logic: 'Evaluate usage frequency, maintenance capacity, storage, and local safety requirements.',
  },
  {
    need: 'Commercial project',
    logic: 'Request a business quotation covering order volume, installation conditions, and maintenance planning.',
  },
];

const compareBeforeBuying = [
  'Pool dimensions and usable water capacity',
  'Recommended operating pressure',
  'Materials and construction',
  'Included accessories',
  'Filtration and heating compatibility',
  'Installation surface and drainage',
  'Cleaning and maintenance requirements',
  'Warranty, shipping, and customer support',
];

const poolTypeRows = [
  {
    aspect: 'Wall structure',
    dropStitch: 'Thousands of internal fibers join the wall layers; walls inflate rigid at the rated 4–5 PSI',
    traditional: 'Air-filled rings or I-beams; walls stay soft at low pressure',
    frame: 'Steel or resin frame carries the load; PVC liner holds the water',
  },
  {
    aspect: 'Shape when filled',
    dropStitch: 'Walls hold their intended shape at operating pressure',
    traditional: 'Walls can flex or bulge under water load',
    frame: 'Frame keeps the shape; liner fit depends on assembly',
  },
  {
    aspect: 'Setup',
    dropStitch: 'Inflate in 5–15 minutes with the included electric pump; no tools',
    traditional: 'Quick to inflate; low pressure',
    frame: 'Frame assembly and liner fitting required',
  },
  {
    aspect: 'Storage',
    dropStitch: 'Drain, dry, deflate, roll up, and pack into the storage bag',
    traditional: 'Compact to store',
    frame: 'Disassembly required before storage',
  },
  {
    aspect: 'Typical best use',
    dropStitch: 'Seasonal rigid-wall swimming and soaking for families and rentals',
    traditional: 'Light play and budget use',
    frame: 'Fixed seasonal placement in one spot',
  },
];

const hubFaqs = [
  {
    q: 'What is a drop stitch inflatable pool?',
    a: 'A drop-stitch inflatable pool uses thousands of internal connecting fibers to link its inner and outer fabric layers. When inflated to the specified operating pressure (4–5 PSI for Felizbay pools), the structure helps the pool walls maintain their intended shape — unlike traditional low-pressure inflatable designs.',
  },
  {
    q: 'Which Felizbay pool is best for a small backyard?',
    a: 'For tight spaces, compare the compact models: the smallest round pool is Ø 2 × 0.5 m, and the square SPA tub starts at 1.5 × 1.5 m. Leave at least 50 cm — ideally 1 m — of clear walkway on all sides, and confirm the surface can support the filled weight (roughly 1 t per m³ of water).',
  },
  {
    q: 'Are drop stitch pools worth the price?',
    a: 'It depends on what you need. Drop-stitch pools inflate to rigid walls at 4–5 PSI, keep their shape when filled, and pack away for off-season storage. If you only need a low-cost play pool for light use, a traditional inflatable pool may be enough. If you want a rigid, seasonal swimming pool that stores away, drop stitch construction is designed for that use.',
  },
  {
    q: 'Which inflatable pool is suitable for a vacation rental?',
    a: 'Seasonal rentals often use round pools from Ø 4–5 m or rectangular pools up to 6 × 5 m. Consider installation time (5–15 minutes inflation plus filling), guest supervision requirements, water care, end-of-season storage, and local safety compliance for rental properties.',
  },
  {
    q: 'Can I buy Felizbay pools at retail?',
    a: 'Yes — selected models are available at retail prices, including the round soaking pool with built-in seats at $499 (Ø 2 × 0.8 m). Rectangular swimming pools and wholesale volumes are quoted FOB — rectangular pools from $285.70, SPA soaking tubs from $381–390 per unit. Retail and wholesale purchases follow different pricing and shipping terms, so check the product page or contact the team for your case.',
  },
  {
    q: 'Do Felizbay pools include a filter pump or heater?',
    a: 'No. Every pool ships with an electric air pump for inflation, a repair kit, and a storage bag. Filter pumps and heaters are external equipment sold separately — pools have standard 32/38 mm filter-pump ports, and SPA tubs can connect to compatible external heaters.',
  },
  {
    q: 'What pressure does a drop stitch pool run at?',
    a: 'Felizbay pools are rated for 4–5 PSI daily operating pressure, with a pressure-relief valve that releases automatically above 6 PSI and a maximum pressure tolerance of 8 PSI. Always follow the pressure instructions in the product manual.',
  },
];

const itemListData = {
  '@type': 'ItemList',
  name: 'Felizbay Drop Stitch Inflatable Pool Collections',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(`/products/${p.slug}/`, SITE.site).toString(),
  })),
};
---

<Layout
  metadata={metadata}
  breadcrumbs={[{ name: 'Products', href: '/products' }, { name: 'Best Drop Stitch Inflatable Pools' }]}
>
  <JsonLd type="ItemList" data={itemListData} />
  <JsonLd type="FAQPage" faqs={hubFaqs} />

  <!-- 01 Direct answer -->
  <section class="px-4 md:px-6 pt-12 pb-8 sm:pt-16 mx-auto max-w-4xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-3">
      Drop Stitch Pool Buying Guide
    </p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
      Best Drop Stitch Inflatable Pools: How to Choose the Right Pool for Your Space
    </h1>
    <p class="mt-6 text-lg text-gray-600 dark:text-slate-400 leading-relaxed">
      Looking for a premium inflatable swimming pool for your backyard, patio, or outdoor retreat? Felizbay offers
      drop-stitch inflatable pools in different shapes and sizes, including swimming pools and seated soaking tubs. The
      right choice depends on your available space, intended use, preferred pool size, and the features you need.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/products"
        class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-primary/90 transition-colors"
      >
        Explore Pools
        <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
      <a
        href="/find-your-pool"
        class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 dark:border-slate-600 text-gray-700 dark:text-slate-300 font-medium rounded-full hover:border-gray-300 dark:hover:border-slate-500 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
      >
        Find Your Pool
      </a>
    </div>
  </section>

  <!-- 02 What is a drop stitch pool -->
  <section class="bg-white dark:bg-slate-950 border-y border-gray-100 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-4">
        What Is a Drop Stitch Inflatable Pool?
      </h2>
      <p class="text-base text-gray-600 dark:text-slate-400 leading-relaxed mb-4">
        A drop-stitch inflatable pool uses thousands of internal connecting fibers to link its inner and outer fabric
        layers. When inflated to the specified operating pressure, the structure helps the pool walls maintain their
        intended shape.
      </p>
      <p class="text-base text-gray-600 dark:text-slate-400 leading-relaxed mb-4">
        Drop-stitch construction is different from traditional inflatable pool designs. However, actual rigidity,
        durability, and performance depend on the materials, construction, operating pressure, installation surface, and
        use conditions.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/guides/what-is-a-drop-stitch-inflatable-pool"
          class="inline-flex items-center gap-1.5 px-4 py-2 border border-gray-200 dark:border-slate-700 rounded-full text-sm font-medium text-gray-600 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          <Icon name="tabler:book" class="w-4 h-4" /> What Is a Drop Stitch Pool?
        </a>
        <a
          href="/guides/drop-stitch-vs-traditional-inflatable-pools"
          class="inline-flex items-center gap-1.5 px-4 py-2 border border-gray-200 dark:border-slate-700 rounded-full text-sm font-medium text-gray-600 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
        >
          <Icon name="tabler:arrows-diff" class="w-4 h-4" /> Drop Stitch vs Traditional Pools
        </a>
      </div>
    </div>
  </section>

  <!-- 03 Model comparison -->
  <section class="px-4 sm:px-6 py-12 mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">Compare the Pool Collections</h2>
      <p class="mt-3 text-lg text-gray-500 dark:text-slate-400 max-w-2xl mx-auto">
        Four collections, 48 standard sizes. Dimensions, capacity, operating pressure, and price basis — full
        specifications live on each product page.
      </p>
    </div>
    <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-700">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 dark:bg-slate-800/60 text-left">
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Collection</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Sizes</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Capacity</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Pressure</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Price Basis</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Best For</th>
          </tr>
        </thead>
        <tbody>
          {
            collectionRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-900/60'}>
                <td class="px-4 py-3">
                  <a class="font-medium text-primary dark:text-blue-400 hover:underline" href={row.href}>
                    {row.collection}
                  </a>
                </td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300 whitespace-nowrap">{row.sizes}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.capacity}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300 whitespace-nowrap">{row.pressure}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300 whitespace-nowrap">{row.price}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.bestFor}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="mt-6 grid sm:grid-cols-3 gap-4 text-sm">
      <a
        href="/products/compare"
        class="inline-flex items-center justify-center gap-2 px-4 py-3 bg-primary text-white font-semibold rounded-xl hover:bg-primary/90 transition-colors"
      >
        <Icon name="tabler:arrows-diff" class="w-4 h-4" /> Compare All Models
      </a>
      <a
        href="/products/specs"
        class="inline-flex items-center justify-center gap-2 px-4 py-3 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
      >
        <Icon name="tabler:table" class="w-4 h-4" /> Full Specification Sheets
      </a>
      <a
        href="/find-your-pool"
        class="inline-flex items-center justify-center gap-2 px-4 py-3 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
      >
        <Icon name="tabler:compass" class="w-4 h-4" /> Find Your Pool
      </a>
    </div>
  </section>

  <!-- 04 By-scenario recommendations -->
  <section class="bg-white dark:bg-slate-950 border-y border-gray-100 dark:border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading text-center">
        Which Pool Is Right for You?
      </h2>
      <p class="mt-3 text-lg text-gray-500 dark:text-slate-400 text-center max-w-2xl mx-auto mb-10">
        Not every inflatable pool is designed for the same purpose. Start from your space and how you plan to use it.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {
          scenarios.map((s) => (
            <div class="flex flex-col bg-gray-50/60 dark:bg-slate-900/60 rounded-2xl border border-gray-100 dark:border-slate-800 p-6">
              <div class="flex items-center gap-3 mb-3">
                <Icon name={s.icon} class="w-7 h-7 text-primary dark:text-blue-400" />
                <h3 class="text-lg font-semibold font-heading dark:text-slate-100">{s.title}</h3>
              </div>
              <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed flex-1">{s.text}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {s.links.map((l) => (
                  <a
                    href={l.href}
                    class="inline-flex items-center gap-1 px-3 py-1.5 border border-gray-200 dark:border-slate-700 rounded-full text-xs font-medium text-gray-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-primary dark:hover:text-blue-400 transition-colors"
                  >
                    {l.text}
                    <Icon name="tabler:arrow-right" class="w-3 h-3" />
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-12 overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-700">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-slate-800/60 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Your Need</th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">How We Recommend a Model</th>
            </tr>
          </thead>
          <tbody>
            {
              recommendationRules.map((r, i) => (
                <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-900/60'}>
                  <td class="px-4 py-3 font-medium text-gray-900 dark:text-slate-100 whitespace-nowrap">{r.need}</td>
                  <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{r.logic}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 05 Drop stitch vs other pool types -->
  <section class="px-4 sm:px-6 py-12 mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">
        Drop Stitch vs Traditional Inflatable vs Frame Pools
      </h2>
      <p class="mt-3 text-lg text-gray-500 dark:text-slate-400 max-w-2xl mx-auto">
        Three different construction approaches. Compare the actual products you are considering — construction and
        performance differ by brand and model.
      </p>
    </div>
    <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-slate-700">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 dark:bg-slate-800/60 text-left">
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Aspect</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Drop Stitch Pool</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Traditional Inflatable Pool</th>
            <th class="px-4 py-3 font-semibold text-gray-900 dark:text-slate-100">Steel-Frame Pool</th>
          </tr>
        </thead>
        <tbody>
          {
            poolTypeRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-900/60'}>
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-slate-100">{row.aspect}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.dropStitch}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.traditional}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-slate-300">{row.frame}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-400 dark:text-slate-500">
      The table describes typical construction differences. It is not a tested performance comparison against any
      specific brand or model.
    </p>
  </section>

  <!-- 06 What to compare before buying -->
  <section class="bg-white dark:bg-slate-950 border-y border-gray-100 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-4">
        What Should You Compare Before Buying?
      </h2>
      <ul class="mt-6 grid sm:grid-cols-2 gap-3">
        {
          compareBeforeBuying.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-gray-600 dark:text-slate-300">
              <Icon name="tabler:circle-check" class="w-5 h-5 text-primary dark:text-blue-400 shrink-0 mt-0.5" />
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">
        A filled pool is heavy — install only on a surface that supports the full weight, and have elevated decks,
        balconies, and rooftops structurally assessed first. Children must be actively supervised by an adult at all
        times.
      </p>
    </div>
  </section>

  <!-- 07 FAQ -->
  <section class="px-4 sm:px-6 py-12 mx-auto max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-8">
      Drop Stitch Pool FAQ
    </h2>
    <div class="space-y-3">
      {
        hubFaqs.map((f) => (
          <details class="group rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 open:shadow-sm transition-shadow">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-sm font-semibold text-gray-900 dark:text-slate-200 list-none">
              {f.q}
              <span class="shrink-0 ml-2 text-gray-300 dark:text-slate-600 group-open:rotate-180 transition-transform text-xs">
                &#9660;
              </span>
            </summary>
            <div class="px-5 pb-4 text-sm text-gray-600 dark:text-slate-400 leading-relaxed border-t border-gray-100 dark:border-slate-700 pt-3 mt-0">
              {f.a}
            </div>
          </details>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <a
        href="/faq"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary dark:text-blue-400 hover:underline"
      >
        All inflatable pool FAQs
        <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </section>

  <!-- 08 Buy entry -->
  <section class="bg-gray-900 dark:bg-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-14 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white font-heading">Explore Felizbay Pools</h2>
      <p class="mt-4 text-lg text-gray-300 leading-relaxed">
        Compare available models, review product specifications, and choose the pool that best matches your space and
        intended use.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-primary/90 transition-colors"
        >

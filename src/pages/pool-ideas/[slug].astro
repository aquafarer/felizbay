---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { POOL_IDEAS, findPoolIdea } from '~/data/pool-ideas';
import { poolSeries } from '~/data/pool-catalog';
import { SITE } from 'astrowind:config';
import type { MetaData } from '~/types';

export function getStaticPaths() {
  return POOL_IDEAS.map((idea) => ({ params: { slug: idea.slug } }));
}

const { slug } = Astro.params;
// getStaticPaths only generates valid slugs; the fallback keeps types narrow without a top-level return.
const idea = findPoolIdea(slug || '') ?? POOL_IDEAS[0];

const seriesById: Record<string, (typeof poolSeries)[number]> = {};
for (const s of poolSeries) seriesById[s.id] = s;

const matchCards = idea.matches.map((m) => {
  const s = seriesById[m.series];
  return {
    ...m,
    name: s?.name ?? m.series,
    heading: s?.heading ?? '',
    sizeRange: s?.sizeRange ?? '',
    items: s?.items ?? [],
  };
});

const otherIdeas = POOL_IDEAS.filter((i) => i.slug !== idea.slug);

const metadata = merge(
  {
    title: `${idea.title} | ${SITE.name}`,
    description: idea.intro[0].slice(0, 155),
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const crumbs = [{ name: 'Pool Ideas', href: '/pool-ideas' }, { name: idea.title }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-4 md:px-6 pt-12 md:pt-16 pb-10 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-12 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">{idea.eyebrow}</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">{idea.title}</h1>
      {idea.intro.map((p) => <p class="mt-4 text-lg text-gray-500 dark:text-slate-400 leading-relaxed">{p}</p>)}
    </header>
  </section>

  <!-- Is this you? -->
  <section class="bg-gray-50/50 dark:bg-slate-900/50 border-y border-gray-100 dark:border-slate-800">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
        Is this the right fit?
      </h2>
      <div class="grid gap-3 md:grid-cols-2">
        {
          idea.conditions.map((c) => (
            <div class="flex items-start gap-3 p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700">
              <Icon name="tabler:circle-check" class="w-5 h-5 mt-0.5 text-green-500 shrink-0" />
              <p class="text-sm text-gray-600 dark:text-slate-300 leading-relaxed">{c}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Matched product families -->
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">
      Recommended Felizbay products
    </h2>
    <div class="grid gap-6 lg:grid-cols-2">
      {
        matchCards.map((m) => (
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 p-6 shadow-sm">
            <h3 class="text-lg font-semibold font-heading dark:text-slate-100 mb-1">{m.name}</h3>
            <p class="text-sm font-medium text-primary dark:text-blue-400 mb-3">{m.sizeRange}</p>
            <p class="text-sm text-gray-600 dark:text-slate-400 leading-relaxed mb-4">{m.reason}</p>
            <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-gray-50 dark:bg-slate-800/70 text-left">
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                      Item
                    </th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                      Size (m)
                    </th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                      Wall
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {m.items.map((it, idx) => (
                    <tr class={idx % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-gray-50/60 dark:bg-slate-800/40'}>
                      <td class="px-3 py-2 font-mono text-xs text-gray-500 dark:text-slate-400">{it.item}</td>
                      <td class="px-3 py-2 text-gray-800 dark:text-slate-200">{it.size}</td>
                      <td class="px-3 py-2 text-gray-500 dark:text-slate-400">{it.wall}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-xs text-gray-400 dark:text-slate-500">
              Full retail models, photos and specs live in the shop — this is the factory size ladder.
            </p>
          </div>
        ))
      }
    </div>
    {idea.tableNote && <p class="mt-6 text-sm text-gray-500 dark:text-slate-400 max-w-3xl">{idea.tableNote}</p>}
  </section>

  <!-- Safety -->
  <section class="bg-amber-50/60 dark:bg-amber-900/15 border-y border-amber-200/70 dark:border-amber-800/40">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">Safety notes</h2>
      <ul class="space-y-2.5 max-w-3xl">
        {
          idea.safety.map((s) => (
            <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-slate-300 leading-relaxed">
              <span class="w-1.5 h-1.5 mt-2 rounded-full bg-amber-500 shrink-0" />
              <span>{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-900 dark:bg-slate-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-4">{idea.cta}</h2>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-all"
        >
          <Icon name="tabler:shopping-cart" class="w-5 h-5" />
          Shop All Pools
        </a>
        <a
          href="/find-your-pool"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-medium rounded-full hover:bg-white/10 transition-all"
        >
          Find Your Pool
        </a>
      </div>
    </div>
  </section>

  <!-- More ideas -->
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
    <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100 mb-6">More pool ideas</h2>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        otherIdeas.map((o) => (
          <a
            href={`/pool-ideas/${o.slug}`}
            class="block p-5 bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 hover:shadow-md transition-shadow"
          >
            <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-200">{o.navTitle}</h3>
            <p class="mt-1 text-xs text-gray-500 dark:text-slate-400 line-clamp-2">{o.intro[0]}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-sky-600 dark:text-sky-400">
              Read more
              <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import JsonLd from '~/components/common/JsonLd.astro';
import Tldr from '~/components/common/Tldr.astro';
import { faqs } from '~/data/faq';
import { guides } from '~/data/guides';
import { procurementGuides } from '~/data/procurement-guides';
import { findProductsBySlugs } from '~/utils/products';
import { getPermalink } from '~/utils/permalinks';
import { defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

const lang = Astro.locals.lang;

const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const metadata = {
  title: `Inflatable Pool FAQ: Setup, Care, Sizing & Warranty | ${SITE.name}`,
  description:
    'Frequently asked questions about Felizbay drop stitch inflatable swimming pools — setup, water care, storage, and ordering.',
};

const categories = [...new Set(faqs.map((f) => f.category))];

const categoryLabels: Record<string, string> = {
  sourcing: 'Sourcing & OEM (B2B)',
};

const relatedProductSlugs = [...new Set(faqs.flatMap((f) => f.relatedProducts))];
const relatedProducts = await findProductsBySlugs(relatedProductSlugs);
const productBySlug: Record<string, { title: string; href: string }> = {};
for (const p of relatedProducts) {
  productBySlug[p.slug] = { title: p.title, href: getPermalink(p.permalink, 'product') };
}

const guideTitleBySlug: Record<string, string> = {};
for (const g of [...guides, ...procurementGuides]) guideTitleBySlug[g.slug] = g.title;
---

<Layout metadata={metadata}>
  <meta name="ai-intent" content="faq,inflatable-pool-questions,pool-buying-faq" />

  <section class="max-w-3xl mx-auto py-24 px-6" data-ai-block="faq">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('faq.pageLabel')}</span>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">{t('faq.title')}</h1>
    <p class="mt-4 text-lg text-gray-500">{t('faq.pageDesc')}</p>

    <Tldr summary={t('home.tldr.summary')} className="mt-8" />
  </section>

  {
    categories.map((cat) => (
      <section class="max-w-3xl mx-auto pb-16 px-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">
          {t('faq.category.' + cat) || categoryLabels[cat] || cat}
        </h2>
        <div class="space-y-4">
          {faqs
            .filter((f) => f.category === cat)
            .map((item) => (
              <details class="bg-white border border-gray-200 rounded-xl overflow-hidden group">
                <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 transition-colors list-none flex items-center justify-between">
                  <span>{item.question}</span>
                  <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0">▼</span>
                </summary>
                <div class="px-6 pb-4 space-y-3">
                  <p class="text-gray-600 leading-relaxed">{item.answer}</p>
                  {(item.relatedProducts.length > 0 || item.relatedGuides.length > 0) && (
                    <div class="flex flex-wrap items-center gap-2 pt-1">
                      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">
                        Related
                      </span>
                      {item.relatedProducts.map((slug) =>
                        productBySlug[slug] ? (
                          <a
                            href={productBySlug[slug].href}
                            class="px-3 py-1 text-sm bg-sky-50 dark:bg-slate-800 text-sky-700 dark:text-sky-300 rounded-full hover:bg-sky-100 dark:hover:bg-slate-700 transition-colors"
                          >
                            {productBySlug[slug].title}
                          </a>
                        ) : null
                      )}
                      {item.relatedGuides.map((slug) =>
                        guideTitleBySlug[slug] ? (
                          <a
                            href={`/guides/${slug}`}
                            class="px-3 py-1 text-sm bg-gray-50 dark:bg-slate-800 text-gray-600 dark:text-slate-300 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors"
                          >
                            {guideTitleBySlug[slug]}
                          </a>
                        ) : null
                      )}
                    </div>
                  )}
                </div>
              </details>
            ))}
        </div>
      </section>
    ))
  }

  <section class="max-w-3xl mx-auto pb-24 px-6">
    <div class="p-8 rounded-2xl bg-sky-50 dark:bg-slate-800/60 border border-sky-100 dark:border-slate-700 text-center">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-100 mb-2">Still comparing models?</h2>
      <p class="text-gray-500 dark:text-slate-400 mb-6 max-w-xl mx-auto">
        Read the full buying guide — collection comparison, scenario recommendations, and a pre-purchase checklist.
      </p>
      <a
        href="/best-drop-stitch-inflatable-pools"
        class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-slate-700 text-white font-semibold rounded-full hover:bg-gray-800 dark:hover:bg-slate-600 transition-all text-sm"
      >
        Best Drop Stitch Inflatable Pools — Buying Guide
      </a>
    </div>
  </section>

  <JsonLd type="FAQPage" faqs={faqs.map((f) => ({ q: f.question, a: f.answer }))} />
</Layout>

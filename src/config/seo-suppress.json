{
  "_comment": "渲染层 noindex 判定配置。paths 为精确路径，regex 为路径前缀规则。渲染时输出 <meta name=robots content='noindex, follow'>。37 语言已全部毕业（TECH.md §16.4），/en/ 镜像路径 noindex。",
  "regex": [
    "^/(?:[a-z]{2}/)?internal/",
    "^/(?:[a-z]{2}/)?login/?$",
    "^/(?:[a-z]{2}/)?keystatic/",
    "^/(?:[a-z]{2}/)?ai-context/?$",
    "^/(?:[a-z]{2}/)?search/?$",
    "^/(?:[a-z]{2}/)?internal/seo/",
    "^/(?:[a-z]{2}/)?register/?$",
    "^/en/"
  ],
  "compareAllowlist": [],
  "compareRegex": "^\\/(?:[a-z]{2}\\/)?compare\\/([^/]+)\\/?$",
  "minWordsToIndex": 100,
  "paths": []
}

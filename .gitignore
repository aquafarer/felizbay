# build output
dist/
.output/
output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.dev.vars
cloudfalre.txt

# macOS-specific files
.DS_Store

pnpm-lock.yaml

.astro

# wrangler local cache
.wrangler/
.wrangler-tmp/

# keystatic local cache (created on first admin load)
.keystatic/

# yarn berry linker artefacts (recreated by `yarn install`)
.yarn/
.pnp.*
# Note: .yarnrc.yml is tracked in git so Cloudflare's yarn install
# uses the same nodeLinker: node-modules and produce a node_modules
# tree that `npm run build` (and `node_modules/.bin/astro`) need.
# R2-managed files (served from Cloudflare R2, not git)
public/files/

# Backup files
*.bak

public/data/
src/i18n/generated/

tmp-root.txt
NUL
workers/*/node_modules/
workers/*/.wrangler/
functions/.wrangler/
.cache/
# python bytecode
__pycache__/
*.pyc
.cache/page-translate-home-cache.json
.cache/page-translate-home-cache2.json
.cache/p0-fix-cache.json
.cache/p0-fix-v2-cache.json
.cache/subtitle-cache.json
p1-home-cache

.deveco/

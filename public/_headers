/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/files/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

/favicon/*
  Cache-Control: public, max-age=31536000, immutable

/*.xml
  Cache-Control: public, max-age=3600

/*.txt
  Cache-Control: public, max-age=3600

# Markdown endpoints (extensionless prerendered APIRoutes) — CF Pages would
# otherwise serve them as application/octet-stream.
/llms/*
  Content-Type: text/markdown; charset=utf-8

/llms-index
  Content-Type: text/markdown; charset=utf-8

/contact/*
  Cache-Control: public, max-age=0, s-maxage=0

/search/*
  Cache-Control: public, max-age=0, s-maxage=300

# HSTS: site is HTTPS-only (www→apex 301, CF Always Use HTTPS).
# Deliberately NO preload directive — semi-irreversible, add only after a
# full-subdomain HTTPS audit. CSP intentionally absent: heavy inline scripts
# (Astro islands + Turnstile + CF beacon) would require nonce/hash work.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, s-maxage=3600
  CDN-Cache-Control: public, max-age=3600
